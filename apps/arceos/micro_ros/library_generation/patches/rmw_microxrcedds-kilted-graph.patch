+rmw_ret_t rmw_uros_enable_graph(void)
+{
+  if (!session_memory.is_initialized || NULL == session_memory.allocateditems) {
+    RMW_UROS_TRACE_MESSAGE("Cannot enable graph data without an initialized XRCE session")
+    return RMW_RET_ERROR;
+  }
+
+  rmw_uxrce_mempool_item_t * item = session_memory.allocateditems;
+  rmw_context_impl_t * context = (rmw_context_impl_t *)item->data;
+  rmw_graph_info_t * graph_info = &context->graph_info;
+  if (graph_info->data_requested) {
+    return RMW_RET_OK;
+  }
+
+  // Request data only after the application has created all of its entities.
+  // Starting this flow in rmw_graph_init() lets full graph snapshots compete
+  // with XRCE CREATE/STATUS traffic during startup.
   uxrDeliveryControl delivery_control;
-  delivery_control.max_samples = UXR_MAX_SAMPLES_UNLIMITED;
+  // One complete snapshot is enough for the initial cache fill. Continuous
+  // full-graph updates can overrun the Agent's reliable output history when
+  // short-lived ROS CLI nodes repeatedly join and leave the graph.
+  delivery_control.max_samples = 1;
   delivery_control.min_pace_period = 0;
   delivery_control.max_elapsed_time = UXR_MAX_ELAPSED_TIME_UNLIMITED;
   delivery_control.max_bytes_per_second = UXR_MAX_BYTES_PER_SECOND_UNLIMITED;
@@ -146,8 +171,8 @@ rmw_ret_t rmw_graph_init(
     context->reliable_output, graph_info->datareader_id,
     context->reliable_input, &delivery_control);
 
-end:
-  return ret;
+  graph_info->data_requested = true;
+  return RMW_RET_OK;
 }
 
