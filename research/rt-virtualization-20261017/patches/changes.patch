@@ -0,0 +1,35 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <inttypes.h>
+#include <sched.h>
+#include <stdint.h>
+#include <stdio.h>
+
+int main(void)
+{
+    cpu_set_t mask;
+    CPU_ZERO(&mask);
+    CPU_SET(0, &mask);
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (sched_setaffinity(0, sizeof(mask), &mask) != 0) {
+        printf("LINUX_LOAD_FAILED operation=affinity errno=%d\n", errno);
+        return 1;
+    }
+    printf("LINUX_LOAD_READY version=1 guest_cpu=0 batch_iterations=8192 report_batches=256\n");
+    volatile uint64_t checksum = 1;
+    uint64_t batches = 0;
+    for (;;) {
+        for (unsigned int i = 0; i < 8192; ++i)
+            checksum = checksum * UINT64_C(6364136223846793005) + 1;
+        ++batches;
+        if (batches % 256 == 0) {
+            int cpu = sched_getcpu();
+            if (cpu != 0) {
+                printf("LINUX_LOAD_FAILED operation=cpu guest_cpu=%d\n", cpu);
+                return 1;
+            }
+            printf("LINUX_LOAD_PROGRESS batches=%" PRIu64 " checksum=%" PRIu64 " guest_cpu=%d\n",
+                   batches, checksum, cpu);
+        }
+    }
+}
diff --git a/virtualization/axvm/tests/support/clock.rs b/virtualization/axvm/tests/support/clock.rs
new file mode 100644
index 000000000..8d53ee2e0
--- /dev/null
+++ b/virtualization/axvm/tests/support/clock.rs
@@ -0,0 +1,110 @@
+//! Test-only cross-domain counter calibration over immutable reply windows.
+
+use std::{
+    time::{Duration, Instant},
+    vec::Vec,
+};
+
+use aarch64_cpu::asm::barrier::{ISH, SY, dmb, isb};
+use anyhow::{Result, ensure};
+use axvm::{GuestMemoryPort, GuestPhysAddr};
+
+use super::Fixture;
+
+pub const CLOCK_START: u32 = 33;
+
+pub struct Probe {
+    pub phase: &'static str,
+    pub sequence: u32,
+    pub before: u64,
+    pub guest: u64,
+    pub after: u64,
+}
+
+pub struct Delivery {
+    pub submitted: u64,
+    pub guest: u64,
+    pub observed: u64,
+}
+
+pub fn host_ticks() -> u64 {
+    let ticks = ax_cpu::timer::physical_counter();
+    // Also prevent following request stores from preceding this sample.
+    isb(SY);
+    ticks
+}
+
+pub fn read_word(memory: &GuestMemoryPort, address: GuestPhysAddr) -> Result<u64> {
+    // Guest release-publishes the reply/received byte before this acquire
+    // barrier. Its payload stays immutable until the host's next request.
+    dmb(ISH);
+    let mut bytes = [0; 8];
+    memory.read_bytes(address, &mut bytes)?;
+    Ok(u64::from_le_bytes(bytes))
+}
+
+pub fn calibrate(
+    fixture: &mut Fixture,
+    memory: &GuestMemoryPort,
+    address: GuestPhysAddr,
+    phase: &'static str,
+    first: u32,
+) -> Result<Vec<Probe>> {
+    let deadline = Instant::now() + Duration::from_secs(30);
+    let mut probes = Vec::with_capacity(32);
+    for sequence in first..first + 32 {
+        let before = host_ticks();
+        memory.write_bytes(address + 20, &sequence.to_le_bytes())?;
+        loop {
+            // Sequence <= 65: only the low byte ever changes. The memory
+            // copy API need not provide an atomic multi-byte snapshot.
+            let mut ack = [0; 1];
+            memory.read_bytes(address + 24, &mut ack)?;
+            if u32::from(ack[0]) == sequence {
+                break;
+            }
+            ensure!(Instant::now() < deadline, "clock calibration timed out");
+            fixture.flush_console()?;
+            std::thread::yield_now();
+        }
+        let guest = read_word(memory, address + 32)?;
+        let after = host_ticks();
+        ensure!(before <= after, "host counter moved backwards");
+        probes.push(Probe {
+            phase,
+            sequence,
+            before,
+            guest,
+            after,
+        });
+    }
+    Ok(probes)
+}
+
+pub fn offset_bounds(probes: &[Probe]) -> Result<(i128, i128)> {
+    let low = probes
+        .iter()
+        .map(|p| i128::from(p.before) - i128::from(p.guest))
+        .max()
+        .expect("calibration has probes");
+    let high = probes
+        .iter()
+        .map(|p| i128::from(p.after) - i128::from(p.guest))
+        .min()
+        .expect("calibration has probes");
+    ensure!(low <= high, "clock offset intervals do not intersect");
+    Ok((low, high))
+}
+
+pub fn validate_delivery(sample: &Delivery, low: i128, high: i128) -> Result<()> {
+    ensure!(
+        sample.submitted <= sample.observed,
+        "host counter moved backwards"
+    );
+    ensure!(
+        i128::from(sample.guest) + high >= i128::from(sample.submitted)
+            && i128::from(sample.guest) + low <= i128::from(sample.observed),
+        "ISR timestamp is outside its causal host window"
+    );
+    Ok(())
+}
diff --git a/virtualization/axvm/tests/support/contention.rs b/virtualization/axvm/tests/support/contention.rs
new file mode 100644
index 000000000..34e3302de
--- /dev/null
+++ b/virtualization/axvm/tests/support/contention.rs
@@ -0,0 +1,194 @@
+//! Host work owned through startup, sampling, VM shutdown, and joined cleanup.
+
+#[path = "contention/work.rs"]
+mod work;
+use std::{
+    sync::{
+        Arc,
+        atomic::{AtomicBool, AtomicU64, Ordering},
+    },
+    thread::JoinHandle,
+    time::{Duration, Instant},
+};
+
+use anyhow::{Context, Result, ensure};
+pub use work::Workload;
+use work::{CPU_ITERATIONS, MEMORY_WORDS_PER_BATCH, WorkResult, WorkState};
+
+#[derive(Default)]
+struct Shared {
+    active: AtomicBool,
+    run_gate: ax_std::os::arceos::api::task::AxWaitQueueHandle,
+    stop: AtomicBool,
+    exited: AtomicBool,
+    batches: AtomicU64,
+    wrong_cpu: AtomicU64,
+}
+
+struct WorkerReport {
+    thread: u64,
+    work: WorkResult,
+}
+
+pub struct HostContention {
+    shared: Arc<Shared>,
+    worker: Option<JoinHandle<Result<WorkerReport>>>,
+    spec: Workload,
+}
+
+impl HostContention {
+    pub fn start(spec: Workload) -> Result<Self> {
+        spec.validate()?;
+        ensure!(
+            spec.cpu() < ax_std::os::arceos::task::sched::cpu_topology_len()?,
+            "contention CPU is unavailable"
+        );
+        let shared = Arc::new(Shared::default());
+        let worker_shared = shared.clone();
+        let worker = std::thread::Builder::new()
+            .name(format!("virq-host-load-cpu{}", spec.cpu()))
+            .spawn(move || {
+                let result = execute(&worker_shared, spec);
+                worker_shared.exited.store(true, Ordering::Release);
+                result
+            })
+            .context("spawn host contention worker")?;
+        let mut load = Self {
+            shared,
+            worker: Some(worker),
+            spec,
+        };
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while load.batches() == 0 {
+            if load.shared.exited.load(Ordering::Acquire) {
+                // Join observes the worker's original allocation/setup error.
+                load.join()?;
+                anyhow::bail!("host load ended at startup");
+            }
+            ensure!(Instant::now() < deadline, "host load startup timed out");
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        Ok(load)
+    }
+
+    pub fn activate(&self) -> Result<()> {
+        use ax_std::os::arceos::api::task::ax_wait_queue_wake;
+        let before = self.batches();
+        self.shared.active.store(true, Ordering::Release);
+        ax_wait_queue_wake(&self.shared.run_gate, 1);
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while self.batches() == before {
+            ensure!(
+                !self.shared.exited.load(Ordering::Acquire),
+                "host load exited before activation"
+            );
+            ensure!(Instant::now() < deadline, "host load activation timed out");
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        Ok(())
+    }
+
+    pub fn batches(&self) -> u64 {
+        // Pure completed-batch count, not publication of the private buffer.
+        self.shared.batches.load(Ordering::Relaxed)
+    }
+
+    pub fn finish(mut self, start_batches: u64, end_batches: u64, policy: &str) -> Result<()> {
+        let unexpectedly_exited = self.shared.exited.load(Ordering::Acquire);
+        let report = self.join()?.context("host load was already joined")?;
+        let wrong_cpu = self.shared.wrong_cpu.load(Ordering::Relaxed);
+        ensure!(
+            !unexpectedly_exited,
+            "host load ended before sampling finished"
+        );
+        ensure!(
+            end_batches > start_batches,
+            "host load made no sampling progress"
+        );
+        ensure!(wrong_cpu == 0, "host load left its requested CPU");
+        let cpu = self.spec.cpu();
+        let thread = report.thread;
+        let final_batches = self.batches();
+        match report.work {
+            WorkResult::Cpu { checksum } => println!(
+                "VIRQ_LOAD_SUMMARY policy={policy} cpu={cpu} thread={thread} \
+                 batch_iterations={CPU_ITERATIONS} start_batches={start_batches} \
+                 end_batches={end_batches} final_batches={final_batches} wrong_cpu={wrong_cpu} \
+                 checksum={checksum} joined=1"
+            ),
+            WorkResult::Memory {
+                bytes,
+                checksum,
+                verified_words,
+                read_bytes,
+                write_bytes,
+            } => println!(
+                "VIRQ_MEMORY_SUMMARY policy={policy} cpu={cpu} thread={thread} \
+                 working_set_bytes={bytes} chunk_words={MEMORY_WORDS_PER_BATCH} \
+                 start_batches={start_batches} end_batches={end_batches} \
+                 final_batches={final_batches} read_bytes={read_bytes} write_bytes={write_bytes} \
+                 checksum={checksum} verified_words={verified_words} mismatch_words=0 \
+                 wrong_cpu={wrong_cpu} joined=1"
+            ),
+        }
+        Ok(())
+    }
+
+    fn join(&mut self) -> Result<Option<WorkerReport>> {
+        self.shared.stop.store(true, Ordering::Release);
+        ax_std::os::arceos::api::task::ax_wait_queue_wake(&self.shared.run_gate, 1);
+        self.worker
+            .take()
+            .map(|worker| {
+                worker
+                    .join()
+                    .map_err(|_| anyhow::anyhow!("host load panicked"))?
+            })
+            .transpose()
+    }
+}
+
+impl Drop for HostContention {
+    fn drop(&mut self) {
+        if let Err(error) = self.join() {
+            println!("VIRQ_LOAD_CLEANUP_FAILED {error:#}");
+        }
+    }
+}
+
+fn execute(shared: &Shared, spec: Workload) -> Result<WorkerReport> {
+    use ax_std::os::arceos::{
+        api::task::{AxCpuMask, ax_current_task_id, ax_set_current_affinity},
+        modules::ax_hal::percpu::this_cpu_id,
+    };
+    let cpu = spec.cpu();
+    ax_set_current_affinity(AxCpuMask::one_shot(cpu)).context("pin host contention worker")?;
+    let thread = ax_current_task_id();
+    let mut work = WorkState::new(spec)?;
+    let mut batches = 0u64;
+    loop {
+        if batches != 0 && !shared.active.load(Ordering::Acquire) {
+            ax_std::os::arceos::api::task::ax_wait_queue_wait_until(
+                &shared.run_gate,
+                || shared.active.load(Ordering::Acquire) || shared.stop.load(Ordering::Acquire),
+                None,
+            );
+        }
+        if shared.stop.load(Ordering::Acquire) {
+            break;
+        }
+        if this_cpu_id() != cpu {
+            shared.wrong_cpu.fetch_add(1, Ordering::Relaxed);
+        }
+        work.run_batch();
+        batches = batches
+            .checked_add(1)
+            .context("host load batch count overflow")?;
+        shared.batches.store(batches, Ordering::Relaxed);
+        std::thread::yield_now();
+    }
+    Ok(WorkerReport {
+        thread,
+        work: work.finish(batches)?,
+    })
+}
diff --git a/virtualization/axvm/tests/support/contention/work.rs b/virtualization/axvm/tests/support/contention/work.rs
new file mode 100644
index 000000000..04e6f3f81
--- /dev/null
+++ b/virtualization/axvm/tests/support/contention/work.rs
@@ -0,0 +1,136 @@
+//! Worker-owned operations; neither buffers nor pointers leave this module.
+
+use std::vec::Vec;
+
+use anyhow::{Context, Result, ensure};
+
+pub const CPU_ITERATIONS: u64 = 8192;
+pub const MEMORY_WORDS_PER_BATCH: usize = 1024;
+pub const MEMORY_BYTES_PER_BATCH: usize = MEMORY_WORDS_PER_BATCH * 8;
+
+#[derive(Clone, Copy)]
+pub enum Workload {
+    Cpu,
+    Memory { bytes: usize, cpu: usize },
+}
+
+impl Workload {
+    pub(super) fn cpu(self) -> usize {
+        match self {
+            Self::Cpu => 1,
+            Self::Memory { cpu, .. } => cpu,
+        }
+    }
+
+    pub(super) fn validate(self) -> Result<()> {
+        if let Self::Memory { bytes, cpu } = self {
+            ensure!(
+                matches!(cpu, 2 | 3),
+                "memory worker must use a dedicated fixture CPU"
+            );
+            ensure!(
+                (1024 * 1024..=64 * 1024 * 1024).contains(&bytes)
+                    && bytes.is_multiple_of(MEMORY_BYTES_PER_BATCH),
+                "invalid memory working set"
+            );
+        }
+        Ok(())
+    }
+}
+
+pub(super) enum WorkState {
+    Cpu { checksum: u64 },
+    Memory { words: Vec<u64>, cursor: usize },
+}
+
+pub(super) enum WorkResult {
+    Cpu {
+        checksum: u64,
+    },
+    Memory {
+        bytes: usize,
+        checksum: u64,
+        verified_words: usize,
+        read_bytes: u64,
+        write_bytes: u64,
+    },
+}
+
+impl WorkState {
+    pub(super) fn new(spec: Workload) -> Result<Self> {
+        match spec {
+            Workload::Cpu => Ok(Self::Cpu { checksum: 1 }),
+            Workload::Memory { bytes, .. } => {
+                let len = bytes / 8;
+                let mut words = Vec::new();
+                words
+                    .try_reserve_exact(len)
+                    .context("allocate memory working set")?;
+                words.extend((0..len).map(|index| index as u64));
+                Ok(Self::Memory { words, cursor: 0 })
+            }
+        }
+    }
+
+    pub(super) fn run_batch(&mut self) {
+        match self {
+            Self::Cpu { checksum } => {
+                for _ in 0..CPU_ITERATIONS {
+                    *checksum = std::hint::black_box(
+                        checksum.wrapping_mul(6364136223846793005).wrapping_add(1),
+                    );
+                }
+            }
+            Self::Memory { words, cursor } => {
+                for word in &mut words[*cursor..*cursor + MEMORY_WORDS_PER_BATCH] {
+                    let pointer = word as *mut u64;
+                    // SAFETY: the safe slice iterator supplies one aligned,
+                    // initialized word in this worker's exclusive live Vec.
+                    // No other task, guest or DMA agent has its address. These
+                    // accesses finish before yielding or freeing the buffer.
+                    unsafe {
+                        let value = pointer.read_volatile();
+                        pointer.write_volatile(value.wrapping_add(1));
+                    }
+                }
+                *cursor += MEMORY_WORDS_PER_BATCH;
+                if *cursor == words.len() {
+                    *cursor = 0;
+                }
+            }
+        }
+    }
+
+    pub(super) fn finish(self, batches: u64) -> Result<WorkResult> {
+        match self {
+            Self::Cpu { checksum } => Ok(WorkResult::Cpu { checksum }),
+            Self::Memory { words, .. } => {
+                let chunks = words.len() / MEMORY_WORDS_PER_BATCH;
+                let sweeps = batches / chunks as u64;
+                let extra_words = (batches % chunks as u64) as usize * MEMORY_WORDS_PER_BATCH;
+                let mut checksum = 0u64;
+                for (index, actual) in words.iter().enumerate() {
+                    let expected = (index as u64)
+                        .wrapping_add(sweeps)
+                        .wrapping_add(u64::from(index < extra_words));
+                    ensure!(
+                        *actual == expected,
+                        "memory working set verification failed at word {index}"
+                    );
+                    checksum = checksum.wrapping_add(*actual);
+                }
+                let bytes = words.len() * 8;
+                let read_bytes = batches
+                    .checked_mul(MEMORY_BYTES_PER_BATCH as u64)
+                    .context("memory byte count overflow")?;
+                Ok(WorkResult::Memory {
+                    bytes,
+                    checksum,
+                    verified_words: words.len(),
+                    read_bytes,
+                    write_bytes: read_bytes,
+                })
+            }
+        }
+    }
+}
diff --git a/virtualization/axvm/tests/support/inversion.rs b/virtualization/axvm/tests/support/inversion.rs
new file mode 100644
index 000000000..3c5170249
--- /dev/null
+++ b/virtualization/axvm/tests/support/inversion.rs
@@ -0,0 +1,129 @@
+//! One finite FIFO60 witness on the IRQ service CPU, joined on every exit.
+
+use std::{
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    },
+    thread::JoinHandle,
+    time::{Duration, Instant},
+};
+
+use anyhow::{Context, Result, ensure};
+use ax_std::os::arceos::api::task::{
+    AxCpuMask, AxWaitQueueHandle, ax_set_current_affinity, ax_wait_queue_wait_until,
+    ax_wait_queue_wake,
+};
+use axvm::{RtPriority, SchedulePolicy};
+
+#[derive(Default)]
+struct Shared {
+    ready: AtomicBool,
+    active: AtomicBool,
+    stop: AtomicBool,
+    exited: AtomicBool,
+    gate: AxWaitQueueHandle,
+}
+
+pub struct Report {
+    pub start: u64,
+    pub end: u64,
+    pub thread: u64,
+    pub wrong_cpu: u64,
+}
+
+pub struct Witness {
+    shared: Arc<Shared>,
+    worker: Option<JoinHandle<Result<Report>>>,
+}
+
+impl Witness {
+    pub fn start() -> Result<Self> {
+        let shared = Arc::new(Shared::default());
+        let worker_shared = shared.clone();
+        let worker = std::thread::Builder::new()
+            .name("virq-fifo60-witness".into())
+            .spawn(move || {
+                let result = execute(&worker_shared);
+                worker_shared.exited.store(true, Ordering::Release);
+                result
+            })?;
+        let mut witness = Self {
+            shared,
+            worker: Some(worker),
+        };
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while !witness.shared.ready.load(Ordering::Acquire) {
+            if witness.shared.exited.load(Ordering::Acquire) {
+                witness.finish()?;
+                anyhow::bail!("inversion witness exited before registration");
+            }
+            ensure!(
+                Instant::now() < deadline,
+                "inversion witness startup timed out"
+            );
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        Ok(witness)
+    }
+
+    /// Called only after arming a delayed physical IRQ on CPU0.
+    pub fn activate(&self) {
+        self.shared.active.store(true, Ordering::Release);
+        ax_wait_queue_wake(&self.shared.gate, 1);
+    }
+
+    pub fn finish(&mut self) -> Result<Report> {
+        self.worker
+            .take()
+            .context("inversion witness already joined")?
+            .join()
+            .map_err(|_| anyhow::anyhow!("inversion witness panicked"))?
+    }
+}
+
+impl Drop for Witness {
+    fn drop(&mut self) {
+        if self.worker.is_some() {
+            self.shared.stop.store(true, Ordering::Release);
+            ax_wait_queue_wake(&self.shared.gate, 1);
+            if let Err(error) = self.finish() {
+                panic!("inversion witness cleanup failed: {error:#}");
+            }
+        }
+    }
+}
+
+fn execute(shared: &Shared) -> Result<Report> {
+    ax_set_current_affinity(AxCpuMask::one_shot(0)).context("pin inversion witness")?;
+    let current = ax_std::os::arceos::task::thread::current::current_thread_handle()?;
+    let policy = SchedulePolicy::fifo(RtPriority::new(60)?);
+    current.set_policy(policy)?;
+    ensure!(
+        current.base_policy() == policy,
+        "inversion witness policy mismatch"
+    );
+    let thread = current.id().as_u64();
+    shared.ready.store(true, Ordering::Release);
+    ax_wait_queue_wait_until(
+        &shared.gate,
+        || shared.active.load(Ordering::Acquire) || shared.stop.load(Ordering::Acquire),
+        None,
+    );
+    let start = super::clock::host_ticks();
+    let duration = ax_cpu::timer::counter_frequency() / 20;
+    let mut wrong_cpu = 0;
+    while !shared.stop.load(Ordering::Acquire)
+        && super::clock::host_ticks().saturating_sub(start) < duration
+    {
+        wrong_cpu += u64::from(ax_std::os::arceos::modules::ax_hal::percpu::this_cpu_id() != 0);
+        core::hint::spin_loop();
+    }
+    let end = super::clock::host_ticks();
+    Ok(Report {
+        start,
+        end,
+        thread,
+        wrong_cpu,
+    })
+}
diff --git a/virtualization/axvm/tests/support/linux.rs b/virtualization/axvm/tests/support/linux.rs
new file mode 100644
index 000000000..0c48414aa
--- /dev/null
+++ b/virtualization/axvm/tests/support/linux.rs
@@ -0,0 +1,155 @@
+//! Consume bounded serial progress from a separate Linux guest; no shared GPA.
+
+use std::time::{Duration, Instant};
+
+use anyhow::{Context, Result, ensure};
+use axvm::{SchedulePolicy, VmStatus};
+
+use super::support::Fixture;
+
+#[derive(Default)]
+pub struct Progress {
+    offset: usize,
+    ready: bool,
+    batches: u64,
+    checksum: u64,
+    reports: u64,
+}
+
+impl Progress {
+    pub fn start(fixture: &mut Fixture) -> Result<Self> {
+        fixture.vm.start()?.wait()?;
+        fixture.wait(Duration::from_secs(120), |snapshot, _| {
+            snapshot.state == VmStatus::Running && snapshot.cpu.running_vcpu_count == 1
+        })?;
+        let mut progress = Self::default();
+        let deadline = Instant::now() + Duration::from_secs(120);
+        while progress.batches == 0 {
+            progress.poll(fixture)?;
+            ensure!(
+                Instant::now() < deadline,
+                "Linux workload startup timed out"
+            );
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        fixture.check_policy(SchedulePolicy::default(), 1)?;
+        println!(
+            "VIRQ_LINUX_BOOT vm=1 vcpu=0 host_cpu=3 guest_cpu=0 batches={}",
+            progress.batches
+        );
+        Ok(progress)
+    }
+
+    pub fn poll(&mut self, fixture: &mut Fixture) -> Result<u64> {
+        fixture.flush_console()?;
+        let snapshot = fixture.vm.snapshot();
+        ensure!(
+            snapshot.state == VmStatus::Running && snapshot.last_failure.is_none(),
+            "Linux workload stopped before measurement completed"
+        );
+        self.consume(fixture)?;
+        Ok(self.batches)
+    }
+
+    fn consume(&mut self, fixture: &Fixture) -> Result<()> {
+        fixture.validate_console(|text| {
+            while let Some(end) = text[self.offset..].find('\n') {
+                let end = self.offset + end + 1;
+                self.line(text[self.offset..end].trim_end_matches(['\r', '\n']))?;
+                self.offset = end;
+            }
+            Ok(())
+        })
+    }
+
+    fn line(&mut self, line: &str) -> Result<()> {
+        ensure!(
+            !line.contains("LINUX_LOAD_FAILED"),
+            "Linux reported a workload failure"
+        );
+        if line.starts_with("LINUX_LOAD_READY") {
+            ensure!(
+                !self.ready
+                    && line
+                        == "LINUX_LOAD_READY version=1 guest_cpu=0 batch_iterations=8192 \
+                            report_batches=256",
+                "Linux workload readiness protocol mismatch"
+            );
+            self.ready = true;
+        } else if line.starts_with("LINUX_LOAD_PROGRESS") {
+            let mut fields = line.split_whitespace();
+            fields.next();
+            let batches = field(fields.next(), "batches=")?;
+            let checksum = field(fields.next(), "checksum=")?;
+            let cpu = field(fields.next(), "guest_cpu=")?;
+            ensure!(
+                fields.next().is_none() && self.ready && cpu == 0,
+                "Linux workload identity mismatch"
+            );
+            ensure!(
+                Some(batches) == self.batches.checked_add(256),
+                "Linux workload report missing or reordered"
+            );
+            let iterations = batches
+                .checked_mul(8192)
+                .context("Linux iteration count overflow")?;
+            ensure!(
+                checksum == checksum_after(iterations),
+                "Linux workload checksum mismatch"
+            );
+            self.batches = batches;
+            self.checksum = checksum;
+            self.reports += 1;
+        }
+        Ok(())
+    }
+
+    pub fn finish(
+        &mut self,
+        fixture: &mut Fixture,
+        policy: &str,
+        start: u64,
+        end: u64,
+    ) -> Result<()> {
+        self.poll(fixture)?;
+        ensure!(
+            0 < start && start < end && end <= self.batches,
+            "Linux produced no observed progress across the sampling window"
+        );
+        fixture.stop()?;
+        // Stop joins the vCPU and flushes its final complete console records.
+        self.consume(fixture)?;
+        ensure!(
+            fixture.vm.snapshot().cpu.running_vcpu_count == 0,
+            "Linux vCPU remained active"
+        );
+        println!(
+            "VIRQ_LINUX_SUMMARY policy={policy} vm=1 vcpu=0 host_cpu=3 guest_cpu=0 \
+             start_batches={start} end_batches={end} final_batches={} checksum={} reports={} \
+             batch_iterations=8192 report_batches=256 stopped=1",
+            self.batches, self.checksum, self.reports
+        );
+        Ok(())
+    }
+}
+
+fn field(value: Option<&str>, prefix: &str) -> Result<u64> {
+    value
+        .and_then(|v| v.strip_prefix(prefix))
+        .context("Linux workload field missing")?
+        .parse()
+        .context("Linux workload field is not an unsigned integer")
+}
+
+fn checksum_after(mut iterations: u64) -> u64 {
+    let (mut multiplier, mut increment, mut checksum) = (6364136223846793005u64, 1u64, 1u64);
+    while iterations != 0 {
+        if iterations & 1 != 0 {
+            checksum = multiplier.wrapping_mul(checksum).wrapping_add(increment);
+        }
+        increment = multiplier.wrapping_mul(increment).wrapping_add(increment);
+        multiplier = multiplier.wrapping_mul(multiplier);
+        iterations >>= 1;
+    }
+    checksum
+}
diff --git a/virtualization/axvm/tests/support/physical.rs b/virtualization/axvm/tests/support/physical.rs
new file mode 100644
index 000000000..78f3c0a00
--- /dev/null
+++ b/virtualization/axvm/tests/support/physical.rs
@@ -0,0 +1,250 @@
+//! Exclusive QEMU virt CNTP/PPI source, controlled from CPU0.
+
+use core::marker::PhantomData;
+use std::sync::{
+    Arc,
+    atomic::{AtomicU32, Ordering},
+};
+
+use anyhow::{Context, Result, ensure};
+use ax_cpu::timer::{Timer, TimerControl, TimerKind};
+use ax_std::os::arceos::{guard::IrqSaveGuard, modules::ax_hal};
+use axvm::{VcpuInterruptPort, diagnostics::HostIrqCapture};
+
+#[derive(Default)]
+struct Counters {
+    handled: AtomicU32,
+    errors: AtomicU32,
+}
+
+pub struct PhysicalTimer {
+    cpu: usize,
+    irq: Option<ax_hal::irq::IrqHandle>,
+    counters: Arc<Counters>,
+    observation: Option<HostIrqCapture>,
+    original: Option<(u64, TimerControl)>,
+    _not_send_sync: PhantomData<*mut ()>,
+}
+
+impl PhysicalTimer {
+    pub fn start(port: VcpuInterruptPort, cpu: usize) -> Result<Self> {
+        ensure!(
+            ax_hal::platform_name() == "linux,dummy-virt",
+            "CNTP fixture requires QEMU virt"
+        );
+        ensure!(
+            ax_cpu::registers::current_exception_level() == 2,
+            "physical source needs EL2"
+        );
+        ensure!(
+            ax_hal::percpu::this_cpu_id() == 0,
+            "physical controller needs CPU0"
+        );
+        ensure!(
+            cpu <= 1 && cpu < ax_hal::cpu_num(),
+            "invalid physical source CPU"
+        );
+        let irq = ax_hal::irq::resolve_percpu_irq(ax_hal::irq::HwIrq(30))?;
+        let host_irq = ax_hal::time::irq_num();
+        ensure!(
+            host_irq.domain == irq.domain && host_irq.hwirq.0 == 26,
+            "QEMU EL2 CNTHP scheduler PPI26 is required"
+        );
+        ensure!(irq != host_irq, "CNTP is the host scheduler timer");
+        let counters = Arc::new(Counters::default());
+        let handler_counters = counters.clone();
+        let handle = ax_hal::irq::request_irq(
+            irq,
+            ax_hal::irq::IrqRequest::new_concurrent(move |context| {
+                // SAFETY: this action exclusively owns this CPU's CNTP PPI.
+                // IRQ exclusion serializes all bounded task/hard-call sessions;
+                // host clockevents use CNTHP and guest CNTP accesses are trapped.
+                let mut timer = unsafe { Timer::current(TimerKind::Physical) };
+                let pending = timer.control().contains(TimerControl::PENDING);
+                timer.set_control(TimerControl::MASKED);
+                if context.cpu != ax_hal::irq::CpuId(cpu) || !pending || port.pulse().is_err() {
+                    handler_counters.errors.fetch_add(1, Ordering::Relaxed);
+                }
+                handler_counters.handled.fetch_add(1, Ordering::Release);
+                ax_hal::irq::IrqReturn::Handled
+            })
+            .scope(ax_hal::irq::IrqScope::PerCpu {
+                cpus: ax_hal::irq::CpuMask::from_cpu(ax_hal::irq::CpuId(cpu)),
+            })
+            .auto_enable(ax_hal::irq::AutoEnable::No),
+        )
+        .context("request exclusive QEMU CNTP PPI")?;
+        let mut source = Self {
+            cpu,
+            irq: Some(handle),
+            counters,
+            observation: None,
+            original: None,
+            _not_send_sync: PhantomData,
+        };
+        on_cpu(cpu, Operation::SetTrigger(irq))?;
+        source.original = Some(on_cpu(cpu, Operation::Snapshot)?);
+        source.observation = Some(axvm::diagnostics::observe_host_irq(30)?);
+        ax_hal::irq::enable_irq(handle)?;
+        Ok(source)
+    }
+
+    pub fn arm(&self, sequence: u32) -> Result<u64> {
+        ensure!(
+            ax_hal::percpu::this_cpu_id() == 0,
+            "timer controller left CPU0"
+        );
+        ensure!(
+            self.counters.errors.load(Ordering::Acquire) == 0,
+            "physical IRQ handler error"
+        );
+        ensure!(
+            self.counters.handled.load(Ordering::Acquire) == sequence - 1,
+            "unexpected physical IRQ count"
+        );
+        on_cpu(self.cpu, Operation::Arm).map(|(due, _)| due)
+    }
+
+    pub fn check_delivered(&self, sequence: u32) -> Result<()> {
+        ensure!(
+            self.counters.handled.load(Ordering::Acquire) == sequence,
+            "physical source did not deliver exactly once"
+        );
+        ensure!(
+            self.counters.errors.load(Ordering::Acquire) == 0,
+            "physical source handler failed"
+        );
+        Ok(())
+    }
+
+    pub fn finish(mut self, policy: &str, samples: u32) -> Result<()> {
+        self.check_delivered(samples)?;
+        self.close()?;
+        println!(
+            "VIRQ_PHYSICAL_SUMMARY policy={policy} intid=30 cpu={} handled={samples} errors=0 \
+             retired=1",
+            self.cpu
+        );
+        Ok(())
+    }
+
+    fn close(&mut self) -> Result<()> {
+        ensure!(
+            ax_hal::percpu::this_cpu_id() == 0,
+            "timer cleanup left controller CPU0"
+        );
+        if let Some(handle) = self.irq {
+            if self.original.is_some() {
+                on_cpu(self.cpu, Operation::Mask)?;
+            }
+            ax_hal::irq::disable_irq(handle)?;
+            ax_hal::irq::synchronize_irq(handle)?;
+            ax_hal::irq::free_irq(handle)?;
+            self.irq = None;
+        }
+        // Retain the saved bank across a failed remote restore so Drop can retry.
+        if let Some((compare, control)) = self.original {
+            on_cpu(self.cpu, Operation::Restore(compare, control))?;
+            self.original = None;
+        }
+        self.observation.take();
+        Ok(())
+    }
+}
+
+impl Drop for PhysicalTimer {
+    fn drop(&mut self) {
+        if let Err(error) = self.close() {
+            println!("VIRQ_PHYSICAL_CLEANUP_FAILED {error:#}");
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+enum Operation {
+    SetTrigger(ax_hal::irq::IrqId),
+    Snapshot,
+    Arm,
+    Mask,
+    Restore(u64, TimerControl),
+}
+
+struct Request {
+    operation: Operation,
+    reply: Option<core::result::Result<(u64, TimerControl), &'static str>>,
+}
+
+fn on_cpu(cpu: usize, operation: Operation) -> Result<(u64, TimerControl)> {
+    let mut request = Request {
+        operation,
+        reply: None,
+    };
+    // SAFETY: the unique, aligned stack request remains live and unmoved until
+    // synchronous completion/cancellation; no caller lock is held. The callback
+    // is bounded, IRQ-masked, nonallocating, and retains no pointer or Timer view.
+    unsafe {
+        ax_hal::irq::run_on_cpu_sync(
+            ax_hal::irq::CpuId(cpu),
+            operate,
+            core::ptr::from_mut(&mut request).cast(),
+        )?;
+    }
+    request
+        .reply
+        .context("physical hard call did not complete")?
+        .map_err(anyhow::Error::msg)
+}
+
+unsafe fn operate(argument: *mut ()) {
+    // SAFETY: on_cpu owns this initialized stack Request until synchronous
+    // completion; it does not access the request while the callback executes.
+    let request = unsafe { &mut *argument.cast::<Request>() };
+    let _irq = IrqSaveGuard::new();
+    if let Operation::SetTrigger(irq) = request.operation {
+        request.reply = Some(
+            ax_hal::irq::set_trigger(irq, ax_hal::irq::IrqTrigger::Level)
+                .map(|()| (0, TimerControl::empty()))
+                .map_err(|_| "set CNTP PPI trigger failed"),
+        );
+        return;
+    }
+    // SAFETY: the fixture reserved this CPU's disabled PPI before Snapshot;
+    // subsequent operations retain ownership until Mask/synchronize/free, then
+    // Restore. Local IRQ exclusion prevents simultaneous handler access. Guest
+    // CNTP is emulated and CNTHP owns host clockevents, so no other bank user exists.
+    let mut timer = unsafe { Timer::current(TimerKind::Physical) };
+    request.reply = Some(match request.operation {
+        Operation::Snapshot => {
+            let control = timer.control();
+            if control.contains(TimerControl::ENABLE) {
+                Err("CNTP is already enabled")
+            } else {
+                Ok((timer.compare(), control))
+            }
+        }
+        Operation::Arm => {
+            let delay = ax_cpu::timer::counter_frequency() / 1000;
+            if timer.control().contains(TimerControl::ENABLE) {
+                Err("previous comparator remains enabled")
+            } else if delay == 0 {
+                Err("counter frequency is too low")
+            } else if let Some(due) = timer.counter().checked_add(delay) {
+                timer.set_compare(due);
+                timer.set_control(TimerControl::ENABLE);
+                Ok((due, TimerControl::ENABLE))
+            } else {
+                Err("timer deadline overflow")
+            }
+        }
+        Operation::Mask => {
+            timer.set_control(TimerControl::MASKED);
+            Ok((0, TimerControl::MASKED))
+        }
+        Operation::Restore(compare, control) => {
+            timer.set_compare(compare);
+            timer.set_control(control);
+            Ok((compare, control))
+        }
+        Operation::SetTrigger(_) => unreachable!(),
+    });
+}
diff --git a/virtualization/axvm/tests/support/rtc_spi.rs b/virtualization/axvm/tests/support/rtc_spi.rs
new file mode 100644
index 000000000..9dc018f38
--- /dev/null
+++ b/virtualization/axvm/tests/support/rtc_spi.rs
@@ -0,0 +1,303 @@
+//! Exclusive, host-owned QEMU PL031 alarm; never changes the RTC calendar.
+
+use core::marker::PhantomData;
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, AtomicU32, Ordering},
+};
+
+use aarch64_cpu::asm::barrier::{SY, dsb};
+use anyhow::{Context, Result, ensure};
+use ax_arm_pl031::Rtc;
+use ax_std::os::arceos::modules::ax_hal;
+use ax_sync::RawSpinLock;
+use axvm::{VcpuInterruptPort, diagnostics::HostIrqCapture};
+
+static BORROWED: AtomicBool = AtomicBool::new(false);
+
+#[derive(Default)]
+struct Counters {
+    handled: AtomicU32,
+    errors: AtomicU32,
+}
+
+pub struct RtcSpi {
+    bank: Arc<RawSpinLock<Option<Rtc>>>,
+    counters: Arc<Counters>,
+    irq: Option<ax_hal::irq::IrqHandle>,
+    observation: Option<HostIrqCapture>,
+    original: Option<u32>,
+    borrowed: bool,
+    _not_send_sync: PhantomData<*mut ()>,
+}
+
+impl RtcSpi {
+    pub fn start(port: VcpuInterruptPort) -> Result<Self> {
+        ensure!(
+            ax_hal::platform_name() == "linux,dummy-virt",
+            "RTC needs QEMU virt"
+        );
+        ensure!(
+            ax_cpu::registers::current_exception_level() == 2,
+            "RTC needs EL2"
+        );
+        ensure!(
+            ax_hal::percpu::this_cpu_id() == 0,
+            "RTC controller needs CPU0"
+        );
+        verify_firmware()?;
+        let gic = ax_hal::irq::resolve_percpu_irq(ax_hal::irq::HwIrq(30))?;
+        let irq = ax_hal::irq::resolve_irq_source(ax_hal::irq::IrqSource::ControllerLine {
+            domain: gic.domain,
+            hwirq: ax_hal::irq::HwIrq(34),
+        })
+        .context("resolve RTC SPI in the active GIC domain")?;
+        ensure!(
+            irq != ax_hal::time::irq_num(),
+            "RTC aliases the scheduler timer"
+        );
+        ensure!(
+            Some(irq) != ax_hal::console::irq_num(),
+            "RTC aliases the console"
+        );
+        let mut source = Self {
+            bank: Arc::new(RawSpinLock::new(None)),
+            counters: Arc::new(Counters::default()),
+            irq: None,
+            observation: None,
+            original: None,
+            borrowed: false,
+            _not_send_sync: PhantomData,
+        };
+        BORROWED
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .map_err(|_| anyhow::anyhow!("RTC fixture already borrowed"))?;
+        source.borrowed = true;
+        let bank = source.bank.clone();
+        let counters = source.counters.clone();
+        let handle = ax_hal::irq::request_irq(
+            irq,
+            ax_hal::irq::IrqRequest::new_concurrent(move |context| {
+                let valid = {
+                    let mut guard = bank.lock_irqsave();
+                    if let Some(rtc) = guard.as_mut() {
+                        let pending = rtc.interrupt_pending();
+                        rtc.enable_interrupt(false);
+                        rtc.clear_interrupt();
+                        dsb(SY);
+                        pending && !rtc.matched() && !rtc.interrupt_pending()
+                    } else {
+                        false
+                    }
+                };
+                // The callback itself is owned by the IRQ framework, not locked
+                // or shared with task code. Only the register bank is serialized.
+                if context.cpu != ax_hal::irq::CpuId(0) || !valid || port.pulse().is_err() {
+                    counters.errors.fetch_add(1, Ordering::Relaxed);
+                }
+                counters.handled.fetch_add(1, Ordering::Release);
+                ax_hal::irq::IrqReturn::Handled
+            })
+            .affinity(ax_hal::irq::IrqAffinity::Fixed(ax_hal::irq::CpuId(0)))
+            .auto_enable(ax_hal::irq::AutoEnable::No),
+        )
+        .context("request exclusive RTC SPI34")?;
+        source.irq = Some(handle);
+        ax_hal::irq::disable_irq(handle)?;
+        let mapped = ax_mm::iomap(0x0901_0000usize.into(), 0x1000)
+            .context("map exclusive PL031 register page as Device memory")?;
+        let base = mapped.as_usize() as *mut u32;
+        // SAFETY: strict QEMU/FDT admission checked this complete 4KiB PL031
+        // resource; iomap supplies a permanent Device RW mapping. This case has
+        // no host RTC consumer or Guest RTC/counter driver/passthrough. BORROWED
+        // and the disabled exclusive SPI prevent another fixture/IRQ accessor.
+        // Each aligned ID word is within the page. No Rtc view exists yet.
+        let identity: [u32; 8] = unsafe {
+            core::array::from_fn(|index| base.wrapping_add(0xfe0 / 4 + index).read_volatile())
+        };
+        ensure!(
+            identity == [0x31, 0x10, 0x14, 0, 0x0d, 0xf0, 5, 0xb1],
+            "unexpected PL031 identity"
+        );
+        // SAFETY: same live Device mapping and exclusive ownership above.
+        // This is the single Rtc object, published only into the IRQ-safe bank.
+        // The mapping outlives the IRQ callback and is never unmapped by us.
+        let rtc = unsafe { Rtc::new(base) };
+        ensure!(
+            rtc.match_timestamp() == 0
+                && !rtc.interrupt_enabled()
+                && !rtc.matched()
+                && !rtc.interrupt_pending(),
+            "RTC alarm was not inactive"
+        );
+        source.original = Some(rtc.match_timestamp());
+        *source.bank.lock_irqsave() = Some(rtc);
+        ax_hal::irq::set_trigger(irq, ax_hal::irq::IrqTrigger::Level)?;
+        source.observation = Some(axvm::diagnostics::observe_host_irq(34)?);
+        ax_hal::irq::enable_irq(handle)?;
+        println!(
+            "VIRQ_RTC_CONFIG base=0x9010000 intid=34 cpu=0 target_cpu=1 initial_mr=0 imsc=0 ris=0 \
+             mis=0"
+        );
+        Ok(source)
+    }
+
+    pub fn arm(&self, sequence: u32) -> Result<u32> {
+        ensure!(
+            ax_hal::percpu::this_cpu_id() == 0,
+            "RTC controller left CPU0"
+        );
+        self.check_delivered(sequence - 1)?;
+        let handle = self.irq.context("RTC source already closed")?;
+        // Mask the exact controller line before acquiring its register bank.
+        ax_hal::irq::disable_irq(handle)?;
+        let matched = {
+            let mut bank = self.bank.lock_irqsave();
+            let rtc = bank.as_mut().context("RTC bank absent")?;
+            rtc.enable_interrupt(false);
+            rtc.clear_interrupt();
+            dsb(SY);
+            let mut matched = None;
+            for _ in 0..3 {
+                let now = rtc.get_unix_timestamp();
+                rtc.set_match_timestamp(now);
+                dsb(SY);
+                if rtc.matched() {
+                    ensure!(
+                        rtc.match_timestamp() == now
+                            && !rtc.interrupt_enabled()
+                            && !rtc.interrupt_pending(),
+                        "RTC masked alarm state disagrees"
+                    );
+                    matched = Some(now);
+                    break;
+                }
+            }
+            let matched = matched.context("RTC alarm crossed three second boundaries")?;
+            rtc.enable_interrupt(true);
+            dsb(SY);
+            ensure!(
+                rtc.interrupt_enabled() && rtc.interrupt_pending(),
+                "RTC did not assert"
+            );
+            matched
+        };
+        ax_hal::irq::enable_irq(handle)?;
+        Ok(matched)
+    }
+
+    pub fn check_delivered(&self, sequence: u32) -> Result<()> {
+        ensure!(
+            self.counters.handled.load(Ordering::Acquire) == sequence,
+            "RTC interrupt count mismatch"
+        );
+        ensure!(
+            self.counters.errors.load(Ordering::Acquire) == 0,
+            "RTC handler pending/clear/CPU/delivery error"
+        );
+        Ok(())
+    }
+
+    pub fn finish(mut self, policy: &str, samples: u32) -> Result<()> {
+        self.check_delivered(samples)?;
+        self.close()?;
+        println!(
+            "VIRQ_RTC_SUMMARY policy={policy} intid=34 cpu=0 handled={samples} errors=0 retired=1 \
+             restored_mr=0 imsc=0 ris=0 mis=0"
+        );
+        Ok(())
+    }
+
+    fn close(&mut self) -> Result<()> {
+        if !self.borrowed {
+            return Ok(());
+        }
+        ensure!(ax_hal::percpu::this_cpu_id() == 0, "RTC cleanup left CPU0");
+        if let Some(handle) = self.irq {
+            ax_hal::irq::disable_irq(handle)?;
+            {
+                let mut bank = self.bank.lock_irqsave();
+                if let Some(rtc) = bank.as_mut() {
+                    rtc.enable_interrupt(false);
+                    rtc.clear_interrupt();
+                    dsb(SY);
+                }
+            }
+            ax_hal::irq::synchronize_irq(handle)?;
+            ax_hal::irq::free_irq(handle)?;
+            self.irq = None;
+        }
+        if let Some(original) = self.original {
+            let mut bank = self.bank.lock_irqsave();
+            let rtc = bank.as_mut().context("RTC restore lost register owner")?;
+            rtc.enable_interrupt(false);
+            rtc.set_match_timestamp(original);
+            rtc.clear_interrupt();
+            dsb(SY);
+            ensure!(
+                rtc.match_timestamp() == original
+                    && !rtc.interrupt_enabled()
+                    && !rtc.matched()
+                    && !rtc.interrupt_pending(),
+                "RTC restore failed"
+            );
+            self.original = None;
+        }
+        self.observation.take();
+        self.bank.lock_irqsave().take();
+        // All callback and register views are now gone. A failed close leaves
+        // BORROWED set, quarantining the device instead of publishing an alias.
+        BORROWED.store(false, Ordering::Release);
+        self.borrowed = false;
+        Ok(())
+    }
+}
+
+impl Drop for RtcSpi {
+    fn drop(&mut self) {
+        if let Err(error) = self.close() {
+            println!("VIRQ_RTC_CLEANUP_FAILED {error:#}");
+        }
+    }
+}
+
+fn verify_firmware() -> Result<()> {
+    let fdt = ax_hal::dtb::get_fdt().context("RTC firmware absent")?;
+    let mut nodes = fdt.find_compatible(&["arm,pl031"]);
+    let node = nodes.next().context("PL031 absent")?;
+    ensure!(nodes.next().is_none(), "multiple PL031 resources");
+    let reg: std::vec::Vec<u32> = node
+        .find_property("reg")
+        .context("RTC reg absent")?
+        .u32_list()
+        .collect();
+    let interrupts: std::vec::Vec<u32> = node
+        .find_property("interrupts")
+        .context("RTC interrupts absent")?
+        .u32_list()
+        .collect();
+    let parent = node
+        .interrupt_parent()
+        .context("RTC interrupt parent absent")?;
+    ensure!(
+        reg == [0, 0x9010000, 0, 0x1000] && interrupts == [0, 2, 4],
+        "unsupported RTC resource"
+    );
+    ensure!(
+        parent.node.compatibles().any(|s| s == "arm,gic-v3")
+            && parent
+                .node
+                .find_property("#interrupt-cells")
+                .map(|p| p.u32())
+                == Some(3),
+        "RTC needs the QEMU GICv3 binding"
+    );
+    ensure!(
+        matches!(
+            node.find_property("status").map(|p| p.str()),
+            None | Some("okay" | "ok")
+        ),
+        "RTC disabled by firmware"
+    );
+    Ok(())
+}
