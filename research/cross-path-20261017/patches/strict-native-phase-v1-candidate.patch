+def timing_failure(binary, output):
+    worker = Worker(binary, output, 'late-diagnostics')
+    try:
+        worker.begin()
+        epoch = time.clock_gettime_ns(time.CLOCK_MONOTONIC_RAW) + 2 * FREQUENCY
+        worker.send(arm(epoch))
+        worker.until(lambda s: s.startswith('LINUX_PHASE_ARMED'))
+        os.kill(worker.process.pid, signal.SIGSTOP)
+        while time.clock_gettime_ns(time.CLOCK_MONOTONIC_RAW) < epoch + 20_000_000:
+            select.select([], [], [], 0.001)
+        os.kill(worker.process.pid, signal.SIGCONT)
+        worker.fail('timing')
+        slots = [r for r in worker.diagnostic['records'] if r['kind'] == 'slot']
+        assert len(slots) == 32
+        for slot in slots:
+            verify_work(slot)
+        snapshots = [r for r in worker.diagnostic['records'] if r['kind'] == 'snapshot']
+        assert len(snapshots) == 2 and int(snapshots[0]['actual']) - epoch >= 20_000_000
+        assert not any(s.startswith('LINUX_PHASE_DATA') for s in worker.lines)
+        return 'late snapshots/bursts preserve 32 slots and fail process'
+    finally:
+        if worker.process.poll() is None:
+            os.kill(worker.process.pid, signal.SIGCONT)
+        worker.close()
+
