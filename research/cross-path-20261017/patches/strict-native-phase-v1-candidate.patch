@@ -0,0 +1,65 @@
+#ifndef LINUX_LOAD_PHASE_H
+#define LINUX_LOAD_PHASE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifndef LINUX_PHASE_TEST_CLOCK
+#define LINUX_PHASE_TEST_CLOCK 0
+#endif
+#if LINUX_PHASE_TEST_CLOCK != 0 && LINUX_PHASE_TEST_CLOCK != 1
+#error "LINUX_PHASE_TEST_CLOCK must be zero or one"
+#endif
+
+#define PHASE_COUNT 32
+#define PHASE_FRAME_BYTES 52
+#define PHASE_RESULT_BYTES 8192
+
+/* Private worker interface; all fields have one writer on the main thread. */
+struct phase_work {
+    uint64_t cpu_batches, cpu_checksum;
+    uint64_t memory_chunks, memory_checksum;
+    uint64_t logical_read_bytes, logical_write_bytes;
+};
+
+struct phase_snapshot {
+    uint64_t planned, actual;
+    struct phase_work work;
+};
+
+struct phase_slot {
+    uint64_t planned, start, end;
+    uint16_t chunks;
+    struct phase_work work;
+};
+
+enum phase_state {
+    PHASE_BEGIN, PHASE_ARM, PHASE_RECEIVING, PHASE_ARMED,
+    PHASE_ACTIVE, PHASE_DONE, PHASE_ENDED
+};
+
+struct phase_context {
+    enum phase_state state;
+    uint8_t frame[PHASE_FRAME_BYTES];
+    size_t received;
+    uint64_t frequency, receive_start, cookie, epoch, period, finish;
+    uint64_t begin_ticks;
+    struct phase_work begin_work;
+    uint8_t flags, offset;
+    unsigned int used;
+    int production_ok, software_ok, published;
+    const char *error;
+    struct phase_snapshot start, end;
+    struct phase_slot slots[PHASE_COUNT];
+    char result[PHASE_RESULT_BYTES];
+};
+
+typedef int (*phase_burst_fn)(void *owner, struct phase_work *work, unsigned int chunks);
+
+int phase_init(struct phase_context *phase);
+int phase_step(struct phase_context *phase, struct phase_work *work,
+               phase_burst_fn burst, void *owner);
+int phase_quiet(const struct phase_context *phase);
+void phase_diagnostics(struct phase_context *phase);
+
+#endif
