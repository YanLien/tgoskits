+def ordering(binary, output):
+    results = []
+    for name, before_arm, extra in [('arm-first', True, b''), ('end-before-epoch', False, b'E'),
+                                    ('duplicate-arm', False, b'A'), ('unknown-before-epoch', False, b'X'),
+                                    ('extra-in-window', False, b'X'), ('end-in-window', False, b'E'),
+                                    ('cpu-in-window', False, b'')]:
+        worker = Worker(binary, output, name)
+        try:
+            if before_arm:
+                worker.until(lambda s: s.startswith('LINUX_PHASE_READY'))
+                worker.send(arm(time.clock_gettime_ns(time.CLOCK_MONOTONIC_RAW) + 2 * FREQUENCY))
+                worker.fail('order')
+            else:
+                worker.begin()
+                epoch = time.clock_gettime_ns(time.CLOCK_MONOTONIC_RAW) + 2 * FREQUENCY
+                worker.send(arm(epoch))
+                worker.until(lambda s: s.startswith('LINUX_PHASE_ARMED'))
+                if name in ('extra-in-window', 'end-in-window', 'cpu-in-window'):
+                    while time.clock_gettime_ns(time.CLOCK_MONOTONIC_RAW) < epoch + PERIOD:
+                        select.select([], [], [], 0.001)
+                if name == 'cpu-in-window':
+                    other = min(os.sched_getaffinity(0) - {0})
+                    migration = dict(operation='sched_setaffinity', pid=worker.process.pid,
+                                     from_cpus=sorted(os.sched_getaffinity(worker.process.pid)), to_cpus=[other],
+                                     time_ns=time.clock_gettime_ns(time.CLOCK_MONOTONIC_RAW), epoch=epoch)
+                    os.sched_setaffinity(worker.process.pid, {other})
+                    migration['actual_cpus'] = sorted(os.sched_getaffinity(worker.process.pid))
+                    (output / (name + '.migration.json')).write_text(json.dumps(migration, indent=2) + '\n')
+                    worker.fail('clock_or_cpu')
+                else:
+                    worker.send(extra)
+                    worker.fail('order')
+                diagnostic = worker.diagnostic
+                slots = [r for r in diagnostic['records'] if r['kind'] == 'slot']
+                snapshots = [r for r in diagnostic['records'] if r['kind'] == 'snapshot']
+                assert not any(s.startswith('LINUX_PHASE_DATA') for s in worker.lines)
+                if name in ('extra-in-window', 'end-in-window'):
+                    assert len(slots) == 32 and len(snapshots) == 2
+                elif name == 'cpu-in-window':
+                    assert 0 < len(slots) < 32 and len(snapshots) == 1
+                    assert snapshots[0]['boundary'] == 'start'
+                    for i, slot in enumerate(slots):
+                        assert int(slot['planned']) == epoch + i * PERIOD
+                        assert int(slot['start']) >= int(slot['planned'])
+                        assert int(slot['end']) >= int(slot['start'])
+                        assert int(slot['chunks']) == 8 and int(slot['memory_chunks']) == (i + 1) * 8
+                    assert not any(r['kind'] == 'result' for r in diagnostic['records'])
+                else:
+                    assert not slots and not snapshots
+            results.append(name)
+        finally:
+            worker.close()
+    return results
+
