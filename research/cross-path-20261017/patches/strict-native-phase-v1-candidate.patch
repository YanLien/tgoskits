+/// Fatal collection belongs to this Progress and never owns another serial reader.
+struct Diagnostic {
+    started: Instant,
+    start_offset: usize,
+    bytes: usize,
+    cookie: u64,
+    first_error: String,
+    header: bool,
+    declared_snapshots: u64,
+    declared_slots: u64,
+    snapshots: u64,
+    slots: u64,
+    ended: bool,
+    terminal: bool,
+    valid: bool,
+    secondary: Vec<String>,
+    work_errors: Vec<String>,
+}
+
+impl Diagnostic {
+    fn new(start_offset: usize) -> Self {
+        Self {
+            started: Instant::now(),
+            start_offset,
+            bytes: 0,
+            cookie: 0,
+            first_error: "malformed_diagnostic".into(),
+            header: false,
+            declared_snapshots: 0,
+            declared_slots: 0,
+            snapshots: 0,
+            slots: 0,
+            ended: false,
+            terminal: false,
+            valid: true,
+            secondary: Vec::with_capacity(16),
+            work_errors: Vec::with_capacity(35),
+        }
+    }
+
+    fn complete(&self) -> bool {
+        self.ended && self.header && self.valid && !self.terminal
+    }
+
+    fn protocol_error(&mut self, error: String) {
+        self.valid = false;
+        self.ancillary(error);
+    }
+
+    fn ancillary(&mut self, error: String) {
+        if self.secondary.len() < 16 && !self.secondary.contains(&error) {
+            self.secondary.push(error);
+        }
+    }
+
+    fn incomplete(&mut self, reason: String) {
+        self.terminal = true;
+        self.protocol_error(reason);
+    }
+
+    fn line(&mut self, line: &str, session: &phase::Session, memory: MemoryConfig) {
+        use phase::transport::DiagnosticRecord;
+        if self.terminal {
+            return;
+        }
+        if line.starts_with("LINUX_LOAD_FAILED operation=") {
+            if line != format!("LINUX_LOAD_FAILED operation=phase_{}", self.first_error) {
+                self.protocol_error("secondary C operation disagrees with first diagnostic".into());
+            }
+            return;
+        }
+        if self.ended && !line.starts_with("LINUX_PHASE_") {
+            return;
+        }
+        let (cookie, record) = match phase::transport::diagnostic(line) {
+            Ok(record) => record,
+            Err(error) => {
+                self.protocol_error(format!("diagnostic syntax: {error:#}"));
+                return;
+            }
+        };
+        if cookie != session.diagnostic_cookie() {
+            self.protocol_error(format!(
+                "diagnostic cookie mismatch actual={cookie} expected={}",
+                session.diagnostic_cookie()
+            ));
+        }
+        if self.ended {
+            self.protocol_error("diagnostic record after END".into());
+            return;
+        }
+        match record {
+            DiagnosticRecord::Begin {
+                error,
+                snapshots,
+                slots,
+            } => {
+                if self.header {
+                    self.protocol_error("duplicate diagnostic begin".into());
+                    return;
+                }
+                self.header = true;
+                self.cookie = cookie;
+                self.first_error = error.into();
+                self.declared_snapshots = snapshots;
+                self.declared_slots = slots;
+            }
+            DiagnosticRecord::Snapshot(raw) => {
+                if !self.header
+                    || self.slots != 0
+                    || self.snapshots >= self.declared_snapshots
+                    || raw.boundary != self.snapshots
+                {
+                    self.protocol_error("diagnostic snapshot order/count mismatch".into());
+                }
+                self.snapshots += 1;
+                if raw.actual < raw.planned || raw.work.guest_cpu != 0 {
+                    self.protocol_error("diagnostic snapshot timing/CPU mismatch".into());
+                }
+                if let Err(error) = phase::Session::diagnostic_work(raw.work, memory) {
+                    self.work_errors.push(format!(
+                        "snapshot boundary={} read={} write={} checksum={}: {error}",
+                        raw.boundary, raw.work.read, raw.work.write, raw.work.memory_checksum
+                    ));
+                }
+            }
+            DiagnosticRecord::Slot(raw) => {
+                if !self.header
+                    || self.snapshots != self.declared_snapshots
+                    || self.slots >= self.declared_slots
+                    || raw.cycle != self.slots
+                {
+                    self.protocol_error("diagnostic slot order/count mismatch".into());
+                }
+                self.slots += 1;
+                if raw.start < raw.planned || raw.end < raw.start || raw.work.guest_cpu != 0 {
+                    self.protocol_error("diagnostic slot timing/CPU mismatch".into());
+                }
+                if let Err(error) = phase::Session::diagnostic_work(raw.work, memory) {
+                    self.work_errors.push(format!(
+                        "slot cycle={} chunks={} memory_chunks={} read={} write={} checksum={}: \
+                         {error}",
+                        raw.cycle,
+                        raw.chunks,
+                        raw.work.chunks,
+                        raw.work.read,
+                        raw.work.write,
+                        raw.work.memory_checksum
+                    ));
+                }
+            }
+            DiagnosticRecord::End {
+                error,
+                snapshots,
+                slots,
+                rows,
+            } => {
+                if !self.header
+                    || error != self.first_error
+                    || cookie != self.cookie
+                    || snapshots != self.declared_snapshots
+                    || snapshots != self.snapshots
+                    || slots != self.declared_slots
+                    || slots != self.slots
+                    || rows != self.snapshots + self.slots
+                {
+                    self.protocol_error("diagnostic END identity/count mismatch".into());
+                }
+                self.ended = true;
+            }
+        }
+    }
