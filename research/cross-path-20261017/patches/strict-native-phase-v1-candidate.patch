+def diagnostic_work_failure(source_dir, output):
+    # Corrupt one future word only in an archived temporary C source. The real
+    # memory_chunk must expose its partial accounting through the fatal path.
+    fault_dir = output / 'partial-memory-source'
+    fault_dir.mkdir()
+    for name in ('workload.c', 'phase.c', 'phase.h'):
+        (fault_dir / name).write_bytes((source_dir / name).read_bytes())
+    workload = fault_dir / 'workload.c'
+    original = workload.read_text()
+    needle = '        int status = memory_chunk(memory);'
+    assert original.count(needle) == 1
+    workload.write_text(original.replace(needle,
+        '        if (memory->batches == 8)\n'
+        '            memory->values[memory->cursor + 7] ^= UINT64_C(1);\n' + needle))
+    binary = output / 'partial-memory-worker'
+    command = json.loads((output / 'command.json').read_text())['command']
+    replacements = {str(source_dir / name): str(fault_dir / name) for name in ('workload.c', 'phase.c')}
+    replacements[str(output / 'ordinary-load')] = str(binary)
+    command = [replacements.get(arg, arg) for arg in command]
+    compiled = subprocess.run(command, text=True, capture_output=True)
+    (output / 'partial-memory-build.json').write_text(json.dumps(dict(command=command,
+        exit=compiled.returncode, stdout=compiled.stdout, stderr=compiled.stderr,
+        source_sha256={p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in fault_dir.iterdir()}), indent=2) + '\n')
+    assert compiled.returncode == 0, compiled.stderr
+    worker = Worker(binary, output, 'partial-memory-diagnostics')
+    try:
+        worker.begin()
+        epoch = time.clock_gettime_ns(time.CLOCK_MONOTONIC_RAW) + 2 * FREQUENCY
+        worker.send(arm(epoch, enabled=1, phase=0))
+        worker.until(lambda s: s.startswith('LINUX_PHASE_ARMED'))
+        first_error = worker.fail('memory_verify')
+        diagnostic = worker.diagnostic
+        assert diagnostic['complete'] and diagnostic['header']['error'] == 'memory_verify'
+        assert diagnostic['header']['cookie'] == str(0x4245414245)
+        snapshots = [r for r in diagnostic['records'] if r['kind'] == 'snapshot']
+        slots = [r for r in diagnostic['records'] if r['kind'] == 'slot']
+        assert len(snapshots) == 1 and snapshots[0]['boundary'] == 'start'
+        assert len(slots) == 2 and diagnostic['end']['rows'] == '3'
+        assert diagnostic['end']['result_missing'] == '1'
+        verify_work(snapshots[0])
+        verify_work(slots[0])
+        partial = slots[1]
+        assert partial['cycle'] == '1' and partial['chunks'] == '0'
+        assert int(partial['planned']) == epoch + PERIOD
+        assert int(partial['planned']) <= int(partial['start']) <= int(partial['end'])
+        # One full burst precedes seven successful writes and the eighth read
+        # which detects the corrupted value. No completed chunk is invented.
+        assert partial['memory_chunks'] == '8'
+        assert int(partial['logical_read_bytes']) == 8 * 8192 * 8 + 8 * 8
+        assert int(partial['logical_write_bytes']) == 8 * 8192 * 8 + 7 * 8
+        assert int(partial['memory_checksum']) == memory_sum(8) + sum(range(65537, 65544))
+        assert int(partial['cpu_checksum']) == checksum(int(partial['cpu_batches']) * 8192)
+        errors = diagnostic['work_verification_errors']
+        assert len(errors) == 1 and errors[0]['kind'] == 'slot' and errors[0]['cycle'] == '1'
+        assert not any(s.startswith(('LINUX_PHASE_DATA', 'LINUX_PHASE_RESULT')) for s in worker.lines)
+        assert worker.exit_code == 1 and first_error == 'LINUX_LOAD_FAILED operation=phase_memory_verify'
+        return dict(first_error=diagnostic['header']['error'], diagnostic_complete=True,
+                    snapshots=1, slots=2, partial_work_preserved=True, ancillary_work_errors=len(errors),
+                    worker_exit=worker.exit_code, binary_sha256=hashlib.sha256(binary.read_bytes()).hexdigest())
+    finally:
+        worker.close()
+
