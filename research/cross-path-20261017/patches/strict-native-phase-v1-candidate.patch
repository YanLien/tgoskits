+               '-DLINUX_PHASE=1', '-DLINUX_PHASE_TEST_CLOCK=1']
+    (args.output_dir / 'command.json').write_text(json.dumps(dict(command=command, env=dict(os.environ)), indent=2) + '\n')
+    if args.behavior not in ('prepare', 'wire'):
+        subprocess.run(command, check=True)
+    results = {}
+    try:
+        results['wire'] = decoder_contract()
+        if args.behavior in ('all', 'grid'):
+            results['grid'] = [planned_run(binary, args.output_dir, b, phase) for b, phase in ((0, 0), (1, 0), (0, 1), (1, 1))]
+        if args.behavior in ('all', 'reject'):
+            results['reject'] = rejected_arms(binary, args.output_dir)
+        if args.behavior in ('all', 'ordering'):
+            results['ordering'] = ordering(binary, args.output_dir)
+        if args.behavior in ('all', 'timing'):
+            results['timing'] = timing_failure(binary, args.output_dir)
+        if args.behavior in ('all', 'diagnostics'):
+            results['diagnostics'] = diagnostic_work_failure(args.source_dir, args.output_dir)
+        if args.behavior in ('all', 'prepare'):
+            results['prepare'] = prepare_rejections(args.source_dir, args.output_dir)
+    finally:
+        (args.output_dir / 'result.json').write_text(json.dumps(dict(results=results,
+            source_sha256={p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in sources + [args.source_dir / 'phase.h']},
+            verifier_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+            binary_sha256=hashlib.sha256(binary.read_bytes()).hexdigest() if binary.exists() else None,
+            scope='Native real PTY/SIGIO and CLOCK_MONOTONIC_RAW test_clock=1; no CNTVCT/UART/Host/hardware claim'), indent=2) + '\n')
+    print('LINUX_NATIVE_PHASE_OK ' + json.dumps(results, sort_keys=True))
+
+
