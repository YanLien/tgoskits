diff --git a/virtualization/axvm/src/guest_counter.rs b/virtualization/axvm/src/guest_counter.rs
new file mode 100644
--- /dev/null
+++ b/virtualization/axvm/src/guest_counter.rs
@@ -0,0 +1,56 @@
+//! Immutable observations of the counter domain configured for a VM run.
+
+use crate::RunId;
+
+/// Counter-domain metadata copied at the lifecycle owner's publication boundary.
+///
+/// A retained snapshot describes its original run only. Before using a mapping
+/// for a current operation, consumers must check that the current snapshot is
+/// `Running` and that the observation's run matches their expected [`RunId`].
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum GuestCounterObservation {
+    /// This architecture has no supported guest-counter observation.
+    Unsupported,
+    /// No successfully prepared, currently running counter domain is available.
+    /// This includes ready, paused, stopping, stopped and failed VMs.
+    Inactive,
+    /// The unscaled AArch64 virtual counter configured for this run.
+    Aarch64Virtual {
+        /// Execution identity, including the VM instance identity.
+        run: RunId,
+        /// Nonzero nominal frequency actually exposed to the guest. A machine
+        /// profile may override it; it is not a measured host-counter frequency
+        /// and does not independently provide a ticks-to-nanoseconds conversion.
+        guest_frequency_hz: u64,
+        /// `host_physical_ticks = guest_virtual_ticks + virtual_offset_ticks`
+        /// modulo 2^64. This does not promise guest EL0 counter access or a
+        /// conversion from other guest clocks such as CLOCK_MONOTONIC_RAW.
+        virtual_offset_ticks: u64,
+    },
+}
+
+impl GuestCounterObservation {
+    pub(crate) const fn inactive() -> Self {
+        cfg_select! {
+            target_arch = "aarch64" => Self::Inactive,
+            _ => Self::Unsupported,
+        }
+    }
+}
+
+/// Facts derived from the same immutable configuration passed to every vCPU.
+#[derive(Clone, Copy)]
+pub(crate) struct GuestCounterConfig {
+    pub(crate) guest_frequency_hz: u64,
+    pub(crate) virtual_offset_ticks: u64,
+}
+
+impl GuestCounterConfig {
+    pub(crate) fn observe(self, run: RunId) -> GuestCounterObservation {
+        GuestCounterObservation::Aarch64Virtual {
+            run,
+            guest_frequency_hz: self.guest_frequency_hz,
+            virtual_offset_ticks: self.virtual_offset_ticks,
+        }
+    }
+}
