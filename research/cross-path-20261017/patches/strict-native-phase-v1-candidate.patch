+//! Bounded v2 wire syntax. No run, clock mapping, or acceptance state lives here.
+
+use anyhow::{Context, Result, bail, ensure};
+
+pub(in crate::linux) const MAX_FRAME: usize = 8192;
+const MAX_PAYLOAD: usize = 5895;
+
+#[derive(Clone, Copy, Default)]
+pub(in crate::linux) struct Work {
+    pub cpu: u64,
+    pub cpu_checksum: u64,
+    pub chunks: u64,
+    pub memory_checksum: u64,
+    pub read: u64,
+    pub write: u64,
+    pub guest_cpu: u64,
+}
+
+#[derive(Clone, Copy, Default)]
+pub(in crate::linux) struct Snapshot {
+    pub boundary: u64,
+    pub planned: u64,
+    pub actual: u64,
+    pub work: Work,
+}
+
+#[derive(Clone, Copy, Default)]
+pub(in crate::linux) struct Slot {
+    pub cycle: u64,
+    pub planned: u64,
+    pub start: u64,
+    pub end: u64,
+    pub chunks: u64,
+    pub work: Work,
+}
+
+pub(in crate::linux) struct Outcome {
+    pub slots: u64,
+    pub production: u64,
+    pub software: u64,
+    pub test_clock: u64,
+    pub cpu: u64,
+    pub planned: u64,
+    pub actual: u64,
+    pub negative: u64,
+    pub magnitude: u64,
+}
+
+pub(in crate::linux) struct Data {
+    pub cookie: u64,
+    pub snapshots: [Snapshot; 2],
+    pub slots: [Slot; 32],
+    pub outcome: Outcome,
+}
+
+pub(in crate::linux) fn decode(line: &str) -> Result<Data> {
+    ensure!(
+        line.len().checked_add(1).is_some_and(|n| n <= MAX_FRAME),
+        "phase DATA frame exceeds 8192 bytes including LF"
+    );
+    let mut fields = Fields::new(line);
+    fields.literal("LINUX_PHASE_DATA")?;
+    fields.literal("version=2")?;
+    fields.literal("encoding=table36")?;
+    let cookie = fields.number("cookie=")?;
+    fields.literal("rows=35")?;
+    let bytes = fields.number("payload_bytes=")?;
+    let crc = fields.number("crc32=")?;
+    let payload = fields.value("payload=")?;
+    fields.finish()?;
+    ensure!(
+        payload.len() <= MAX_PAYLOAD && bytes == payload.len() as u64,
+        "phase DATA payload length mismatch"
+    );
+    ensure!(
+        u64::from(crc32(payload.as_bytes())) == crc,
+        "phase DATA CRC mismatch"
+    );
+    let mut records = payload.split(';');
+    let header = row::<3>(records.next(), "H")?;
+    ensure!(
+        header == [2, cookie, 35],
+        "phase DATA outer/header identity mismatch"
+    );
+    let mut snapshots = [Snapshot::default(); 2];
+    for s in &mut snapshots {
+        let v = row::<10>(records.next(), "S")?;
+        *s = Snapshot {
+            boundary: v[0],
+            planned: v[1],
+            actual: v[2],
+            work: work(&v[3..]),
+        };
+    }
+    let mut slots = [Slot::default(); 32];
+    for s in &mut slots {
+        let v = row::<12>(records.next(), "T")?;
+        *s = Slot {
+            cycle: v[0],
+            planned: v[1],
+            start: v[2],
+            end: v[3],
+            chunks: v[4],
+            work: work(&v[5..]),
+        };
+    }
+    let r = row::<9>(records.next(), "R")?;
+    ensure!(records.next().is_none(), "phase DATA has trailing records");
+    ensure!(
+        r[1] <= 1 && r[2] <= 1 && r[3] <= 1 && r[7] <= 1 && !(r[7] == 1 && r[8] == 0),
+        "phase DATA invalid flags or negative zero"
+    );
+    Ok(Data {
+        cookie,
+        snapshots,
+        slots,
+        outcome: Outcome {
+            slots: r[0],
+            production: r[1],
+            software: r[2],
+            test_clock: r[3],
+            cpu: r[4],
+            planned: r[5],
+            actual: r[6],
+            negative: r[7],
+            magnitude: r[8],
+        },
+    })
+}
+
+fn work(v: &[u64]) -> Work {
+    Work {
+        cpu: v[0],
+        cpu_checksum: v[1],
+        chunks: v[2],
+        memory_checksum: v[3],
+        read: v[4],
+        write: v[5],
+        guest_cpu: v[6],
+    }
+}
+
+fn row<const N: usize>(record: Option<&str>, tag: &str) -> Result<[u64; N]> {
+    let mut fields = record.context("phase DATA missing record")?.split(',');
+    ensure!(
+        fields.next() == Some(tag),
+        "phase DATA record order mismatch: expected {tag}"
+    );
+    let mut values = [0; N];
+    for value in &mut values {
+        *value = integer(fields.next().context("phase DATA missing value")?, 36)?;
+    }
+    ensure!(fields.next().is_none(), "phase DATA trailing record values");
+    Ok(values)
+}
+
+fn integer(value: &str, radix: u64) -> Result<u64> {
+    ensure!(
+        !value.is_empty() && (value == "0" || !value.starts_with('0')),
+        "noncanonical phase integer"
+    );
+    let mut number = 0u64;
+    for byte in value.bytes() {
+        let digit = match byte {
+            b'0'..=b'9' => u64::from(byte - b'0'),
+            b'a'..=b'z' if radix == 36 => u64::from(byte - b'a') + 10,
+            _ => bail!("invalid phase integer digit"),
+        };
+        number = number
+            .checked_mul(radix)
+            .and_then(|n| n.checked_add(digit))
+            .context("phase integer overflow")?;
+    }
+    Ok(number)
+}
+
+pub(in crate::linux) struct Fields<'a>(core::str::Split<'a, char>);
+impl<'a> Fields<'a> {
+    pub fn new(line: &'a str) -> Self {
+        Self(line.split(' '))
+    }
+    pub fn next(&mut self) -> Option<&'a str> {
+        self.0.next()
+    }
+    pub fn literal(&mut self, literal: &str) -> Result<()> {
+        ensure!(
+            self.next() == Some(literal),
+            "phase field mismatch: expected {literal}"
+        );
+        Ok(())
+    }
+    pub fn value(&mut self, prefix: &str) -> Result<&'a str> {
+        self.next()
+            .and_then(|v| v.strip_prefix(prefix))
+            .filter(|v| !v.is_empty())
+            .context("phase field missing")
+    }
+    pub fn number(&mut self, prefix: &str) -> Result<u64> {
+        integer(self.value(prefix)?, 10)
+    }
+    pub fn finish(&mut self) -> Result<()> {
+        ensure!(self.next().is_none(), "unexpected phase fields");
+        Ok(())
+    }
+}
+
+pub(in crate::linux) enum DiagnosticRecord<'a> {
+    Begin {
+        error: &'a str,
+        snapshots: u64,
+        slots: u64,
+    },
+    Snapshot(Snapshot),
+    Slot(Slot),
+    End {
+        error: &'a str,
+        snapshots: u64,
+        slots: u64,
+        rows: u64,
+    },
+}
+
+pub(in crate::linux) fn diagnostic(line: &str) -> Result<(u64, DiagnosticRecord<'_>)> {
+    let mut f = Fields::new(line);
+    f.literal("LINUX_PHASE_DIAGNOSTIC")?;
+    f.literal("version=2")?;
+    let cookie = f.number("cookie=")?;
+    let record = match f.value("kind=")? {
+        kind @ ("begin" | "end") => {
+            let error = f.value("error=")?;
+            ensure!(
+                error.len() <= 64
+                    && error
+                        .bytes()
+                        .all(|c| c.is_ascii_lowercase() || c == b'_' || c.is_ascii_digit()),
+                "invalid diagnostic operation"
+            );
+            let snapshots = f.number("snapshots=")?;
+            let slots = f.number("slots=")?;
+            ensure!(
+                snapshots <= 2 && slots <= 32,
+                "diagnostic count exceeds arrays"
+            );
+            let rows = if kind == "end" { f.number("rows=")? } else { 0 };
+            f.literal("result_missing=1")?;
+            if kind == "begin" {
+                DiagnosticRecord::Begin {
+                    error,
+                    snapshots,
+                    slots,
+                }
+            } else {
+                DiagnosticRecord::End {
+                    error,
+                    snapshots,
+                    slots,
+                    rows,
+                }
+            }
+        }
+        "snapshot" => {
+            let boundary = match f.value("boundary=")? {
+                "start" => 0,
+                "end" => 1,
+                _ => bail!("invalid diagnostic boundary"),
+            };
+            DiagnosticRecord::Snapshot(Snapshot {
+                boundary,
+                planned: f.number("planned=")?,
+                actual: f.number("actual=")?,
+                work: decimal_work(&mut f)?,
+            })
+        }
+        "slot" => DiagnosticRecord::Slot(Slot {
+            cycle: f.number("cycle=")?,
+            planned: f.number("planned=")?,
+            start: f.number("start=")?,
+            end: f.number("end=")?,
+            chunks: f.number("chunks=")?,
+            work: decimal_work(&mut f)?,
+        }),
+        _ => bail!("unknown phase diagnostic kind"),
+    };
+    f.finish()?;
+    Ok((cookie, record))
+}
+
+fn decimal_work(f: &mut Fields<'_>) -> Result<Work> {
+    Ok(Work {
+        cpu: f.number("cpu_batches=")?,
+        cpu_checksum: f.number("cpu_checksum=")?,
+        chunks: f.number("memory_chunks=")?,
+        memory_checksum: f.number("memory_checksum=")?,
+        read: f.number("logical_read_bytes=")?,
+        write: f.number("logical_write_bytes=")?,
+        guest_cpu: f.number("guest_cpu=")?,
+    })
+}
+
+pub(in crate::linux) fn crc32(bytes: &[u8]) -> u32 {
+    let mut value = u32::MAX;
+    for byte in bytes {
+        value ^= u32::from(*byte);
+        for _ in 0..8 {
+            value = (value >> 1) ^ (0xedb88320 & 0u32.wrapping_sub(value & 1));
+        }
+    }
+    !value
+}
