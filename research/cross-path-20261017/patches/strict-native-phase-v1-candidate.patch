+def rejected_arms(binary, output):
+    results = []
+    epoch = lambda: time.clock_gettime_ns(time.CLOCK_MONOTONIC_RAW) + 2 * FREQUENCY
+    bad_crc = bytearray(arm(epoch()))
+    bad_crc[-1] ^= 1
+    frames = [('crc', bytes(bad_crc)), ('guard', arm(time.clock_gettime_ns(time.CLOCK_MONOTONIC_RAW))),
+              ('capacity', arm(epoch(), count=33)), ('period', arm(epoch(), period=PERIOD + 2)),
+              ('reserved', arm(epoch(), reserved2=1)), ('overflow', arm(MASK - PERIOD))]
+    for label, frame in frames:
+        worker = Worker(binary, output, 'reject-' + label)
+        try:
+            worker.begin()
+            worker.send(frame)
+            worker.fail(forbid_arm=True)
+            assert not any(s.startswith(('LINUX_PHASE_ARMED', 'LINUX_PHASE_SLOT')) for s in worker.lines)
+            results.append(label)
+        finally:
+            worker.close()
+    worker = Worker(binary, output, 'truncated')
+    try:
+        worker.begin()
+        before = time.monotonic()
+        worker.send(b'AXPB\x01B')
+        worker.fail('timeout')
+        assert 0.45 <= time.monotonic() - before < 2
+        assert not any(s.startswith('LINUX_PHASE_SLOT') for s in worker.lines)
+        results.append('truncated')
+    finally:
+        worker.close()
+    return results
+
