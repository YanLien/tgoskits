+def prepare_rejections(source_dir, output):
+    # Invoke the actual prepare CLI; invalid phase config must fail before files/builds.
+    outcomes = []
+    for label, changes in [('value', {'VIRQ_LINUX_PHASE': '2'}),
+                           ('fences', {'VIRQ_LINUX_PHASE': '1', 'VIRQ_LINUX_FENCES': '0'}),
+                           ('duty', {'VIRQ_LINUX_PHASE': '1', 'VIRQ_LINUX_FENCES': '1',
+                                     'VIRQ_HOST_LOAD': 'linux_memory', 'VIRQ_LINUX_MEMORY_EVERY': '2'}),
+                           ('workset', {'VIRQ_LINUX_PHASE': '1', 'VIRQ_LINUX_FENCES': '1',
+                                        'VIRQ_HOST_LOAD': 'linux_cpu'})]:
+        env = {k: v for k, v in os.environ.items() if not k.startswith('VIRQ_')}
+        env.update(changes)
+        command = ['python3', str(source_dir / 'prepare.py'), '--output', str(output / ('prepare-' + label))]
+        process = subprocess.run(command, env=env, text=True, capture_output=True)
+        (output / ('prepare-' + label + '.json')).write_text(json.dumps(dict(command=command,
+            env=env, stdout=process.stdout, stderr=process.stderr, exit=process.returncode), indent=2) + '\n')
+        assert process.returncode != 0 and 'VIRQ_LINUX_PHASE' in process.stderr, process.stderr
+        assert not (output / ('prepare-' + label)).exists()
+        outcomes.append(label)
