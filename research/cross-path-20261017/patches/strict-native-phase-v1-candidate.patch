+
+    pub fn announce(self, policy: &str) {
+        println!(
+            "VIRQ_LINUX_PHASE_CONFIG version=2 policy={policy} enabled=1 phase={} b_enabled={} \
+             count=32 chunks_per_burst=8 working_set_bytes=16777216 every_batches=1 \
+             planned_window_ns=640000000 source_prewarm_ns=100000000 profile=production",
+            self.phase,
+            u8::from(self.b)
+        );
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Work {
+    cpu: u64,
+    chunks: u64,
+    bytes: u64,
+}
+
+impl Work {
+    fn read(fields: &mut Fields<'_>, memory: MemoryConfig) -> Result<Self> {
+        let cpu = fields.number("cpu_batches=")?;
+        let cpu_checksum = fields.number("cpu_checksum=")?;
+        let chunks = fields.number("memory_chunks=")?;
+        let memory_checksum = fields.number("memory_checksum=")?;
+        let read = fields.number("logical_read_bytes=")?;
+        let write = fields.number("logical_write_bytes=")?;
+        ensure!(
+            fields.number("guest_cpu=")? == 0,
+            "phase work left Guest CPU0"
+        );
+        Self::verify(
+            transport::Work {
+                cpu,
+                cpu_checksum,
+                chunks,
+                memory_checksum,
+                read,
+                write,
+                guest_cpu: 0,
+            },
+            memory,
+        )
+    }
+
+    fn verify(raw: transport::Work, memory: MemoryConfig) -> Result<Self> {
+        let (_, bytes, sum) = memory.expected_chunks(raw.chunks)?;
+        ensure!(raw.guest_cpu == 0, "phase work left Guest CPU0");
+        ensure!(
+            raw.cpu_checksum
+                == checksum_after(
+                    raw.cpu
+                        .checked_mul(8192)
+                        .context("phase CPU iterations overflow")?
+                )
+                && raw.read == bytes / 2
+                && raw.write == bytes / 2
+                && raw.memory_checksum == sum,
+            "phase CPU or actual memory chunk known-answer mismatch"
+        );
+        Ok(Self {
+            cpu: raw.cpu,
+            chunks: raw.chunks,
+            bytes,
+        })
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Fence {
+    ticks: u64,
+    request: u64,
+    observed: u64,
+    work: Work,
+}
+
+#[derive(Clone, Copy)]
+struct Snapshot {
+    actual: u64,
+    work: Work,
+}
+
+#[derive(Clone, Copy)]
+struct Slot {
+    end: u64,
+    work: Work,
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct Plan {
+    pub host_epoch: u64,
+    guest_epoch: u64,
+    period: u64,
+    finish: u64,
+    request: u64,
+}
+
+pub(super) struct Session {
+    config: Config,
+    frequency: Option<u64>,
+    policy: Option<String>,
+    fence_ready: bool,
+    run: Option<RunId>,
+    offset: u64,
+    pending_fence: Option<u64>,
+    begin: Option<Fence>,
+    end: Option<Fence>,
+    plan: Option<Plan>,
+    acknowledged: bool,
+    snapshots: Vec<Snapshot>,
+    slots: Vec<Slot>,
+    result: bool,
+}
+
+impl Session {
+    pub fn new(config: Config) -> Self {
+        Self {
+            config,
+            frequency: None,
+            policy: None,
+            fence_ready: false,
+            run: None,
+            offset: 0,
+            pending_fence: None,
+            begin: None,
+            end: None,
+            plan: None,
+            acknowledged: false,
+            snapshots: Vec::with_capacity(2),
+            slots: Vec::with_capacity(32),
+            result: false,
+        }
+    }
+
+    pub fn bind(&mut self, fixture: &Fixture, expected: RunId) -> Result<()> {
+        let snapshot = fixture.vm.snapshot();
+        ensure!(
+            expected.vm() == fixture.vm.key() && snapshot.state == VmStatus::Running,
+            "Linux counter owner is not the active VM instance"
+        );
+        let (hz, offset) = clock::counter_mapping(&snapshot, expected)?;
+        ensure!(
+            self.fence_ready
+                && self.frequency == Some(hz)
+                && hz == ax_cpu::timer::counter_frequency()
+                && expected.generation() != 0,
+            "Linux READY and active counter frequencies disagree"
+        );
+        ensure!(
+            matches!(snapshot.guest_counter, GuestCounterObservation::Aarch64Virtual { run, .. } if run == expected),
+            "Linux counter run changed during binding"
+        );
+        self.run = Some(expected);
+        self.offset = offset;
+        Ok(())
+    }
+
+    pub(super) fn diagnostic_cookie(&self) -> u64 {
+        if self.plan.is_some() {
+            self.cookie().unwrap_or(0)
+        } else {
+            0
+        }
+    }
+
+    pub(super) fn diagnostic_work(raw: transport::Work, memory: MemoryConfig) -> Result<()> {
+        Work::verify(raw, memory).map(|_| ())
+    }
+
+    pub fn bound(&self) -> bool {
+        self.run.is_some()
+    }
+
+    pub fn verify_run(&self, fixture: &Fixture) -> Result<()> {
+        let run = self.run.context("unbound Linux phase session")?;
+        ensure!(
+            run.vm() == fixture.vm.key()
+                && clock::counter_mapping(&fixture.vm.snapshot(), run)?
+                    == (self.hz()?, self.offset),
+            "Linux phase active run or counter mapping changed"
+        );
+        Ok(())
+    }
+
+    fn hz(&self) -> Result<u64> {
+        self.frequency.context("missing phase frequency")
+    }
+    fn plan(&self) -> Result<Plan> {
+        self.plan.context("phase has no Arm plan")
+    }
+    fn cookie(&self) -> Result<u64> {
+        Ok(self.run.context("unbound phase cookie")?.generation())
+    }
+    fn host(&self, guest: u64) -> Result<u64> {
+        guest
+            .checked_add(self.offset)
+            .context("phase Guest-to-Host counter wraps")
+    }
+
+    pub fn request_fence(&mut self, end: bool) -> Result<()> {
+        ensure!(
+            self.run.is_some()
+                && self.pending_fence.is_none()
+                && if end {
+                    self.result && self.end.is_none()
+                } else {
+                    self.begin.is_none() && self.plan.is_none()
+                },
+            "phase fence request out of order"
+        );
+        self.pending_fence = Some(clock::host_ticks());
+        Ok(())
+    }
+
+    pub fn fence_completed(&self, end: bool) -> bool {
+        if end {
+            self.end.is_some()
+        } else {
+            self.begin.is_some()
+        }
+    }
+    pub fn complete(&self) -> bool {
+        self.result
+    }
+
+    pub fn arm(&mut self, fixture: &mut Fixture, rt_hz: u64, policy: &str) -> Result<Plan> {
+        self.verify_run(fixture)?;
+        let hz = self.hz()?;
+        ensure!(
+            rt_hz == hz && self.begin.is_some() && self.plan.is_none(),
+            "phase Arm frequency or order mismatch"
+        );
+        let period = hz / 50;
+        ensure!(
+            period > 0 && period.is_multiple_of(2) && hz.is_multiple_of(4000),
+            "inexact phase period"
+        );
+        let now = clock::host_ticks();
+        let future = now
+            .checked_add(hz.checked_mul(2).context("phase guard overflow")?)
+            .context("phase epoch overflow")?;
+        let host_epoch = future
+            .div_ceil(period)
+            .checked_mul(period)
+            .context("phase grid overflow")?;
+        let guest_epoch = host_epoch
+            .checked_sub(self.offset)
+            .context("phase Host-to-Guest counter underflow")?;
+        let span = period.checked_mul(COUNT).context("phase span overflow")?;
+        let finish = guest_epoch.checked_add(span).context("phase end wraps")?;
+        ensure!(
+            span < 1u64 << 63
+                && finish
+                    .checked_sub(
+                        now.checked_sub(self.offset)
+                            .context("phase now conversion underflow")?
+                    )
+                    .context("phase horizon reversed")?
+                    < 1u64 << 63,
+            "phase horizon exceeds counter half range"
+        );
+        let mut frame = [0u8; 52];
+        frame[..4].copy_from_slice(b"AXPB");
+        frame[4] = 1;
+        frame[5] = u8::from(self.config.b);
+        frame[6] = self.config.phase as u8;
+        frame[8..16].copy_from_slice(&self.cookie()?.to_le_bytes());
+        frame[16..24].copy_from_slice(&hz.to_le_bytes());
+        frame[24..32].copy_from_slice(&guest_epoch.to_le_bytes());
+        frame[32..40].copy_from_slice(&period.to_le_bytes());
+        frame[40..42].copy_from_slice(&32u16.to_le_bytes());
+        frame[42..44].copy_from_slice(&8u16.to_le_bytes());
+        let crc = crc32(&frame[..48]);
+        frame[48..].copy_from_slice(&crc.to_le_bytes());
+        let request = clock::host_ticks();
+        self.plan = Some(Plan {
+            host_epoch,
+            guest_epoch,
+            period,
+            finish,
+            request,
+        });
+        self.policy = Some(policy.into());
+        fixture.send_input_frame(&frame)?;
+        let run = self.run.context("missing phase run")?;
+        println!(
+            "VIRQ_LINUX_PHASE_PLAN version=2 policy={policy} vm_id={} vm_generation={} \
+             run_generation={} cookie={} frequency_hz={hz} virtual_offset_ticks={} \
+             host_epoch={host_epoch} guest_epoch={guest_epoch} period_ticks={period} \
+             request_before_ticks={request} frame_crc32={crc} phase={} b_enabled={}",
+            run.vm().vm_id(),
+            run.vm().generation(),
+            run.generation(),
+            self.cookie()?,
+            self.offset,
+            self.config.phase,
+            u8::from(self.config.b)
+        );
+        self.plan()
+    }
+
+    pub fn acknowledged(&self) -> bool {
+        self.acknowledged
+    }
+    pub fn epoch(&self) -> Result<u64> {
+        ensure!(self.acknowledged, "phase Arm not acknowledged");
+        Ok(self.plan()?.host_epoch)
+    }
+
+    pub fn validate_release(&self, count: u32, due: u64) -> Result<()> {
+        let p = self.plan()?;
+        let expected = p
+            .host_epoch
+            .checked_add(
+                u64::from(count - 1)
+                    .checked_mul(p.period)
+                    .context("RT phase grid overflow")?,
+            )
+            .context("RT phase due overflow")?;
+        ensure!(
+            (1..=32).contains(&count) && due == expected && due.is_multiple_of(p.period),
+            "RT release left the shared phase grid"
+        );
+        Ok(())
+    }
+
+    pub fn line(&mut self, line: &str, memory: MemoryConfig, batches: u64) -> Result<()> {
+        let mut f = Fields::new(line);
+        let record = f.next().context("empty phase record")?;
+        match record {
+            "LINUX_PHASE_READY" => {
+                ensure!(
+                    self.frequency.is_none() && batches == 0,
+                    "duplicate or late phase readiness"
+                );
+                f.literal("version=2")?;
+                f.literal("arm_wire_version=1")?;
+                f.literal("result_encoding=table36")?;
+                f.literal("test_clock=0")?;
+                let hz = f.number("frequency=")?;
+                f.literal("count=32")?;
+                f.literal("chunks_per_burst=8")?;
+                f.literal("working_set_bytes=16777216")?;
+                ensure!(
+                    hz != 0 && hz.is_multiple_of(4000),
+                    "invalid phase READY frequency"
+                );
+                self.frequency = Some(hz);
+            }
+            "LINUX_FENCE_READY" => {
+                ensure!(
+                    self.frequency.is_some() && !self.fence_ready && batches == 0,
+                    "phase fence readiness order mismatch"
+                );
+                f.literal("version=2")?;
+                f.literal("clock=cntvct_el0")?;
+                ensure!(
+                    f.number("frequency=")? == self.hz()?,
+                    "phase fence READY frequency mismatch"
+                );
+                self.fence_ready = true;
+            }
+            "LINUX_FENCE_REPLY" => {
+                let request = self.pending_fence.context("unsolicited phase fence")?;
+                let end = self.begin.is_some();
+                f.literal("version=2")?;
+                f.literal(if end { "phase=end" } else { "phase=begin" })?;
+                let ticks = f.number("ticks=")?;
+                ensure!(
+                    f.number("frequency=")? == self.hz()?,
+                    "phase fence frequency mismatch"
+                );
+                let work = Work::read(&mut f, memory)?;
+                let observed = clock::host_ticks();
+                let mapped = self.host(ticks)?;
+                ensure!(
+                    request <= mapped && mapped <= observed && work.cpu >= batches && work.cpu > 0,
+                    "phase fence violates causal Host interval"
+                );
+                let fence = Fence {
+                    ticks,
+                    request,
+                    observed,
+                    work,
+                };
+                if end {
+                    let begin = self.begin.context("End without Begin")?;
+                    ensure!(
+                        self.result
+                            && self.end.is_none()
+                            && f.number("whole_cpu_batches=")?
+                                == work
+                                    .cpu
+                                    .checked_sub(begin.work.cpu)
+                                    .context("whole CPU count regressed")?
+                            && f.number("whole_ticks=")?
+                                == ticks
+                                    .checked_sub(begin.ticks)
+                                    .context("whole fence clock regressed")?
+                            && work.chunks == self.final_chunks()
+                            && work.cpu >= self.snapshots[1].work.cpu
+                            && ticks >= self.snapshots[1].actual,
+                        "phase End whole-fence counters mismatch"
+                    );
+                    self.end = Some(fence);
+                } else {
+                    ensure!(
+                        self.plan.is_none() && work.chunks == 0,
+                        "phase Begin has premature B work"
+                    );
+                    self.begin = Some(fence);
+                }
+                self.pending_fence = None;
+            }
+            "LINUX_PHASE_ARMED" => {
+                let p = self.plan()?;
+                ensure!(
+                    !self.acknowledged && self.begin.is_some(),
+                    "duplicate phase ACK"
+                );
+                self.identity(&mut f)?;
+                ensure!(
+                    f.number("flags=")? == u64::from(self.config.b)
+                        && f.number("phase=")? == self.config.phase
+                        && f.number("epoch=")? == p.guest_epoch
+                        && f.number("frequency=")? == self.hz()?
+                        && f.number("period=")? == p.period,
+                    "phase Arm echo mismatch"
+                );
+                f.literal("count=32")?;
+                f.literal("chunks_per_burst=8")?;
+                let accepted = f.number("accepted_ticks=")?;
+                let observed = clock::host_ticks();
+                let mapped = self.host(accepted)?;
+                ensure!(
+                    p.request <= mapped
+                        && mapped <= observed
+                        && p.guest_epoch
+                            .checked_sub(accepted)
+                            .context("phase accepted after epoch")?
+                            >= self.hz()?
+                        && p.host_epoch
+                            .checked_sub(observed)
+                            .context("phase ACK after epoch")?
+                            >= self.hz()? / 2,
+                    "phase ACK violates causal interval or guard"
+                );
+                let run = self.run.context("missing phase ACK run")?;
+                let policy = self.policy.as_deref().context("missing phase ACK policy")?;
+                println!(
+                    "VIRQ_LINUX_PHASE_ACK version=2 policy={policy} vm_id={} vm_generation={} \
+                     run_generation={} cookie={} request_before_ticks={} \
+                     accepted_guest_ticks={accepted} accepted_host_ticks={mapped} \
+                     ack_observed_ticks={observed} host_epoch={}",
+                    run.vm().vm_id(),
+                    run.vm().generation(),
+                    run.generation(),
+                    self.cookie()?,
+                    p.request,
+                    p.host_epoch
+                );
+                self.acknowledged = true;
+            }
+            "LINUX_PHASE_DATA" => {
+                // Decode and validate a bounded temporary observation before committing any result.
+                let decoded = transport::decode(line)?;
+                let (snapshots, slots) = self.validate_data(&decoded, memory)?;
+                self.snapshots = snapshots;
+                self.slots = slots;
+                self.result = true;
+                return Ok(());
+            }
+            _ => bail!("unknown Linux phase or fence record: {line}"),
+        }
+        f.finish()?;
+        Ok(())
+    }
+
+    fn identity(&self, f: &mut Fields<'_>) -> Result<()> {
+        f.literal("version=2")?;
+        ensure!(
+            f.number("cookie=")? == self.cookie()?,
+            "phase cookie belongs to another session"
+        );
+        Ok(())
+    }
+
+    fn validate_data(
+        &self,
+        decoded: &transport::Data,
+        memory: MemoryConfig,
+    ) -> Result<(Vec<Snapshot>, Vec<Slot>)> {
+        ensure!(
+            self.acknowledged && !self.result,
+            "phase DATA is unarmed or duplicate"
+        );
+        ensure!(
+            decoded.cookie == self.cookie()?,
+            "phase DATA cookie belongs to another session"
+        );
+        ensure!(
+            decoded.outcome.test_clock == 0,
+            "phase production Session rejects test_clock=1"
+        );
+        let p = self.plan()?;
+        let mut snapshots: Vec<Snapshot> = Vec::with_capacity(2);
+        let mut slots: Vec<Slot> = Vec::with_capacity(32);
+        let (mut production, mut software) = (true, true);
+        let hz = self.hz()?;
+        let mut timing = |late: u64, duration: u64| {
+            production &= late <= hz / 4000 && duration <= hz / 250;
+            software &= late <= hz / 200 && duration <= hz / 125;
+        };
+        for (index, raw) in decoded.snapshots.iter().enumerate() {
+            ensure!(
+                raw.boundary == index as u64
+                    && raw.planned == if index == 0 { p.guest_epoch } else { p.finish }
+                    && raw.actual >= raw.planned,
+                "phase snapshot identity or timing mismatch"
+            );
+            self.host(raw.actual)?;
+            timing(raw.actual - raw.planned, 0);
+            let work = Work::verify(raw.work, memory)?;
+            ensure!(
+                work.chunks == if index == 0 { 0 } else { self.final_chunks() }
+                    && work.cpu
+                        >= snapshots
+                            .last()
+                            .map_or(self.begin.context("snapshot before Begin")?.work.cpu, |s| s
+                                .work
+                                .cpu),
+                "phase snapshot cumulative work mismatch"
+            );
+            snapshots.push(Snapshot {
+                actual: raw.actual,
+                work,
+            });
+        }
+        for (index, raw) in decoded.slots.iter().enumerate() {
+            let expected = p
+                .guest_epoch
+                .checked_add(
+                    (index as u64)
+                        .checked_mul(p.period)
+                        .context("phase slot multiplication overflow")?,
+                )
+                .and_then(|v| v.checked_add(self.config.phase * (p.period / 2)))
+                .context("phase slot plan overflow")?;
+            let previous = slots.last().copied().unwrap_or(Slot {
+                end: snapshots[0].actual,
+                work: snapshots[0].work,
+            });
+            ensure!(
+                raw.cycle == index as u64
+                    && raw.planned == expected
+                    && raw.start >= raw.planned
+                    && raw.start >= previous.end
+                    && raw.end >= raw.start
+                    && raw.end <= snapshots[1].actual
+                    && raw.chunks == if self.config.b { CHUNKS } else { 0 },
+                "phase slot identity, ordering or burst count mismatch"
+            );
+            self.host(raw.end)?;
+            timing(raw.start - raw.planned, raw.end - raw.start);
+            let work = Work::verify(raw.work, memory)?;
+            ensure!(
+                work.chunks
+                    == previous
+                        .work
+                        .chunks
+                        .checked_add(raw.chunks)
+                        .context("phase chunk total overflow")?
+                    && work.cpu >= previous.work.cpu
+                    && work.cpu <= snapshots[1].work.cpu,
+                "phase slot cumulative work mismatch"
+            );
+            slots.push(Slot { end: raw.end, work });
+        }
+        let (start, end) = (snapshots[0], snapshots[1]);
+        let actual = end
+            .actual
+            .checked_sub(start.actual)
+            .context("phase snapshot time regressed")?;
+        let planned = p
+            .period
+            .checked_mul(COUNT)
+            .context("phase planned window overflow")?;
+        let r = &decoded.outcome;
+        let (negative, magnitude) = if actual < planned {
+            (1, planned - actual)
+        } else {
+            (0, actual - planned)
+        };
+        ensure!(
+            r.slots == COUNT
+                && r.cpu
+                    == end
+                        .work
+                        .cpu
+                        .checked_sub(start.work.cpu)
+                        .context("fixed CPU count regressed")?
+                && r.planned == planned
+                && r.actual == actual
+                && r.negative == negative
+                && r.magnitude == magnitude
+                && r.production == u64::from(production)
+                && r.software == u64::from(software),
+            "phase result totals, flags or delta mismatch"
+        );
+        ensure!(
+            production && software,
+            "phase production timing bounds failed (QEMU is functional evidence only)"
+        );
+        Ok((snapshots, slots))
+    }
+
+    pub(super) fn prove_rejection(&mut self, native: &str, memory: MemoryConfig) -> Result<()> {
+        ensure!(
+            self.acknowledged && !self.complete(),
+            "phase consumption proof requires the actual Arm/ACK"
+        );
+        // Synthetic variants retain the independent native payload, with this real Arm cookie.
+        let payload = native
+            .split_once(" payload=")
+            .context("native payload missing")?
+            .1;
+        let old_header = payload.split(';').next().context("native header missing")?;
+        let payload = payload.replacen(old_header, &format!("H,2,{},z", base36(self.cookie()?)), 1);
+        let prepared = frame(self.cookie()?, &payload);
+        let crc = crc32(payload.as_bytes());
+        let bad_crc = prepared.replacen(&format!("crc32={crc}"), &format!("crc32={}", crc ^ 1), 1);
+        let identity = prepared.replacen(&format!("cookie={}", self.cookie()?), "cookie=0", 1);
+        let missing = frame(
+            self.cookie()?,
+            payload.rsplit_once(';').context("native R missing")?.0,
+        );
+        for (label, rejected, expected_error) in [
+            ("bad_crc", bad_crc, "phase DATA CRC mismatch"),
+            (
+                "identity",
+                identity,
+                "phase DATA outer/header identity mismatch",
+            ),
+            ("missing_record", missing, "phase DATA missing record"),
+            (
+                "test_clock",
+                prepared,
+                "phase production Session rejects test_clock=1",
+            ),
+        ] {
+            let error = self
+                .line(&rejected, memory, 0)
+                .err()
+                .with_context(|| format!("phase Session accepted {label}"))?;
+            ensure!(
+                !self.complete() && self.snapshots.is_empty() && self.slots.is_empty(),
+                "phase rejected DATA committed partial state"
+            );
+            ensure!(
+                error.to_string() == expected_error,
+                "Session rejection case={label} expected={expected_error}, actual={error}"
+            );
+            println!("VIRQ_PHASE_SESSION_REJECT case={label} synthetic=1 real_arm=1 complete=0");
+        }
+        Ok(())
+    }
+
+    fn final_chunks(&self) -> u64 {
+        if self.config.b { COUNT * CHUNKS } else { 0 }
+    }
+
+    pub fn validate_progress(
+        &self,
+        chunks: u64,
+        bytes: u64,
+        checksum: u64,
+        memory: MemoryConfig,
+    ) -> Result<()> {
+        ensure!(
+            self.fence_ready && chunks == if self.result { self.final_chunks() } else { 0 },
+            "phase progress has premature or missing B work"
+        );
+        ensure!(
+            (chunks, bytes, checksum) == memory.expected_chunks(chunks)?,
+            "phase progress memory checksum mismatch"
+        );
+        Ok(())
+    }
+
+    pub fn finish(
+        &self,
+        policy: &str,
+        tasks: &[task_completion::Sample],
+        rt_offset: u64,
+    ) -> Result<PhaseReport> {
+        ensure!(
+            self.result && self.end.is_some() && self.pending_fence.is_none() && tasks.len() == 32,
+            "phase session or RT tasks incomplete"
+        );
+        let begin = self.begin.context("missing Begin")?;
+        let end = self.end.context("missing End")?;
+        let low = self.host(begin.ticks)?;
+        let high = self.host(end.ticks)?;
+        let first_task = tasks
+            .first()
+            .context("phase has no T6")?
+            .start
+            .checked_add(rt_offset)
+            .context("RT counter conversion wraps")?;
+        let last_task = tasks
+            .last()
+            .context("phase has no final T6")?
+            .end
+            .checked_add(rt_offset)
+            .context("RT counter conversion wraps")?;
+        ensure!(
+            low <= self.host(self.snapshots[0].actual)?
+                && self.host(self.snapshots[1].actual)? <= high
+                && low <= first_task
+                && last_task <= high
+                && begin.observed < end.request
+                && begin.work.cpu <= end.work.cpu,
+            "whole fence does not cover all fixed B work and T6"
+        );
+        let p = self.plan()?;
+        let start = self.snapshots[0];
+        let finish = self.snapshots[1];
+        let actual = finish.actual - start.actual;
+        let cpu = finish.work.cpu - start.work.cpu;
+        let bytes = finish.work.bytes - start.work.bytes;
+        let run = self.run.context("missing phase run")?;
+        let line = format!(
+            "VIRQ_LINUX_PHASE_ACCEPT version=2 policy={policy} vm_id={} vm_generation={} \
+             run_generation={} cookie={} phase={} b_enabled={} slots=32 memory_chunks={} \
+             logical_read_bytes={} logical_write_bytes={} planned_window_ticks={} \
+             actual_snapshot_ticks={actual} window_delta_ticks={} cpu_batch_delta={cpu} \
+             logical_byte_delta={bytes} whole_fence_ticks={} whole_cpu_batch_delta={} \
+             begin_request_ticks={} begin_guest_ticks={} begin_observed_ticks={} \
+             end_request_ticks={} end_guest_ticks={} end_observed_ticks={} \
+             first_t6_host_ticks={first_task} last_t6_host_ticks={last_task} production_ok=1 \
+             software_ok=1 test_clock=0 stopped=1 scope=protocol_resources trace_pending=1 \
+             M2=false Joint=false",
+            run.vm().vm_id(),
+            run.vm().generation(),
+            run.generation(),
+            self.cookie()?,
+            self.config.phase,
+            u8::from(self.config.b),
+            self.final_chunks(),
+            bytes / 2,
+            bytes / 2,
+            COUNT * p.period,
+            i128::from(actual) - i128::from(COUNT * p.period),
+            end.ticks - begin.ticks,
+            end.work.cpu - begin.work.cpu,
+            begin.request,
+            begin.ticks,
+            begin.observed,
+            end.request,
+            end.ticks,
+            end.observed
+        );
+        Ok(PhaseReport {
+            line,
+            coverage: (
+                self.host(start.actual)?.min(first_task),
+                self.host(finish.actual)?.max(last_task),
+            ),
+        })
+    }
+}
+
+/// A validated protocol window; publication additionally requires retired resources.
+pub struct PhaseReport {
+    line: String,
+    coverage: (u64, u64),
+}
+
+impl PhaseReport {
+    pub fn coverage(&self) -> (u64, u64) {
+        self.coverage
+    }
+    pub fn emit(&self) {
+        println!("{}", self.line);
+    }
+}
+
+// Native wire proof uses the C archive's independent actual values, not this Session's clock.
+pub(super) fn verify_transport(native: &str) -> Result<()> {
+    let decoded = transport::decode(native)?;
+    ensure!(
+        decoded.cookie == 284629746245
+            && decoded.snapshots[0].planned == 462675540000000
+            && decoded.snapshots[1].work.chunks == 256
+            && decoded.snapshots[1].work.memory_checksum == 2199024304128
+            && decoded.slots[31].cycle == 31
+            && decoded.outcome.test_clock == 1
+            && decoded.outcome.slots == 32,
+        "native C DATA independent known fields mismatch"
+    );
+    let payload = native
+        .split_once(" payload=")
+        .context("native payload missing")?
+        .1;
+    for bad in [
+        payload.replacen("H,2,", "H,02,", 1),
+        payload.replacen("mqpnqx1a12bl", "MQPNQX1A12BL", 1),
+        payload.replacen("mqpnqx1a12bl", "3w5e11264sgsg", 1),
+        format!("{payload};"),
+        payload.replacen("H,2,", "H,+2,", 1),
+    ] {
+        ensure!(
+            transport::decode(&frame(decoded.cookie, &bad)).is_err(),
+            "wire accepted noncanonical or overflowing DATA"
+        );
+    }
+    println!("VIRQ_PHASE_WIRE_PROOF version=2 native=1 test_clock=1 rows=35 records=36");
+    Ok(())
+}
+
+fn frame(cookie: u64, payload: &str) -> String {
+    format!(
+        "LINUX_PHASE_DATA version=2 encoding=table36 cookie={cookie} rows=35 payload_bytes={} \
+         crc32={} payload={payload}",
+        payload.len(),
+        crc32(payload.as_bytes())
+    )
+}
+
+fn base36(mut number: u64) -> String {
+    let mut digits = [0u8; 13];
+    let mut cursor = digits.len();
+    loop {
+        cursor -= 1;
+        let digit = (number % 36) as u8;
+        digits[cursor] = if digit < 10 {
+            b'0' + digit
+        } else {
+            b'a' + digit - 10
+        };
+        number /= 36;
+        if number == 0 {
+            break;
+        }
+    }
+    String::from_utf8_lossy(&digits[cursor..]).into_owned()
+}
